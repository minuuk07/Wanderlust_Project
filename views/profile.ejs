<% layout("/layout/boilerplate") %>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --shadow-sm: 0 5px 15px rgba(0,0,0,0.08);
            --shadow-md: 0 10px 30px rgba(0,0,0,0.12);
            --shadow-lg: 0 20px 50px rgba(0,0,0,0.15);
            --shadow-hover: 0 30px 70px rgba(102, 126, 234, 0.25);
        }

        body {
            background: #f0f2f5;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            min-height: 100vh;
        }

        .profile-container {
            max-width: 1400px;
            margin: 2rem auto;
            padding: 0 1.5rem;
            animation: fadeInUp 1s ease;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .profile-header {
            background: var(--primary-gradient);
            color: white;
            padding: 4rem 2rem;
            border-radius: 40px;
            margin-bottom: 3rem;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-lg);
        }

        .profile-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 60%);
            animation: rotateSlow 25s linear infinite;
        }

        .profile-header::after {
            content: '';
            position: absolute;
            bottom: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: rotateSlow 30s linear infinite reverse;
        }

        @keyframes rotateSlow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .floating-orb {
            position: absolute;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .orb-1 {
            top: -100px;
            right: -100px;
            animation: float 8s ease-in-out infinite;
        }

        .orb-2 {
            bottom: -150px;
            left: -150px;
            width: 400px;
            height: 400px;
            animation: float 12s ease-in-out infinite reverse;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-30px) rotate(10deg); }
        }

        /* ===== AVATAR CONTAINER WITH PERFECT FIT ===== */
        .profile-avatar-container {
            position: relative;
            display: inline-block;
            margin-bottom: 1.5rem;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .profile-avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 5px solid rgba(255,255,255,0.3);
            box-shadow: 0 15px 40px rgba(0,0,0,0.3);
            object-fit: cover;
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            animation: avatarGlow 3s ease-in-out infinite;
            background: #667eea;
            display: block;
        }

        @keyframes avatarGlow {
            0%, 100% { box-shadow: 0 15px 40px rgba(0,0,0,0.3); }
            50% { box-shadow: 0 25px 60px rgba(102, 126, 234, 0.5); }
        }

        .profile-avatar:hover {
            transform: scale(1.1) rotate(5deg);
            border-color: white;
        }

        .avatar-upload-overlay {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(8px);
            border-radius: 50%;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid white;
            box-shadow: 0 4px 16px rgba(0,0,0,0.2);
            color: #667eea;
            font-size: 1.2rem;
            z-index: 10;
        }

        .avatar-upload-overlay:hover {
            transform: scale(1.15);
            background: white;
            box-shadow: 0 6px 24px rgba(102, 126, 234, 0.5);
        }

        .avatar-upload-overlay input[type="file"] {
            position: absolute;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
            z-index: 20;
        }

        .avatar-badge {
            position: absolute;
            bottom: 15px;
            left: 15px;
            width: 25px;
            height: 25px;
            background: #4ade80;
            border: 3px solid white;
            border-radius: 50%;
            animation: pulse 2s ease-in-out infinite;
            z-index: 5;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.2); opacity: 0.8; }
        }

        .profile-name {
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
            background: linear-gradient(to right, #fff, #f0f0f0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shimmer 3s linear infinite;
            background-size: 200% 100%;
        }

        @keyframes shimmer {
            0% { background-position: -100% 0; }
            100% { background-position: 200% 0; }
        }

        .profile-email {
            font-size: 1.2rem;
            opacity: 0.95;
            margin-bottom: 1.5rem;
            display: inline-block;
            padding: 0.5rem 1.5rem;
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(10px);
            border-radius: 50px;
            animation: slideInLeft 0.8s ease;
        }

        @keyframes slideInLeft {
            from { opacity: 0; transform: translateX(-30px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .profile-stats {
            display: flex;
            justify-content: center;
            gap: 3rem;
            margin-top: 2.5rem;
            flex-wrap: wrap;
        }

        .stat-item {
            text-align: center;
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(10px);
            padding: 1.5rem 2.5rem;
            border-radius: 30px;
            min-width: 180px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 1px solid rgba(255,255,255,0.2);
            animation: fadeInUp 0.8s ease backwards;
            position: relative;
            overflow: hidden;
        }

        .stat-item:nth-child(1) { animation-delay: 0.2s; }
        .stat-item:nth-child(2) { animation-delay: 0.4s; }
        .stat-item:nth-child(3) { animation-delay: 0.6s; }

        .stat-item:hover {
            transform: translateY(-15px) scale(1.05);
            box-shadow: 0 30px 60px rgba(0,0,0,0.3);
            border-color: white;
        }

        .stat-number {
            font-size: 2.8rem;
            font-weight: 800;
            display: block;
            line-height: 1.2;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }

        .stat-label {
            font-size: 1rem;
            opacity: 0.9;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .profile-content {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 2.5rem;
            margin-top: 2rem;
        }

        .profile-sidebar,
        .profile-main {
            background: white;
            border-radius: 30px;
            padding: 2.5rem;
            box-shadow: var(--shadow-md);
            transition: all 0.4s ease;
            border: 1px solid rgba(255,255,255,0.1);
            animation: slideInRight 0.8s ease;
        }

        .profile-sidebar {
            animation-name: slideInLeft;
        }

        .profile-main {
            animation-name: slideInRight;
        }

        @keyframes slideInRight {
            from { opacity: 0; transform: translateX(30px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .profile-sidebar:hover,
        .profile-main:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-hover);
        }

        .section-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 1.5rem;
            padding-bottom: 0.8rem;
            border-bottom: 3px solid #f0f0f0;
            position: relative;
            display: inline-block;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -3px;
            left: 0;
            width: 50px;
            height: 3px;
            background: var(--primary-gradient);
            transition: width 0.4s ease;
        }

        .section-title:hover::after {
            width: 100%;
        }

        .info-item {
            margin-bottom: 1.2rem;
            padding: 0.8rem;
            border-radius: 15px;
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
        }

        .info-item:hover {
            background: #f8fafd;
            transform: translateX(10px);
            border-left-color: #667eea;
            box-shadow: var(--shadow-sm);
        }

        .info-label {
            font-size: 0.9rem;
            color: #888;
            margin-bottom: 0.3rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-value {
            font-size: 1.1rem;
            color: #333;
            font-weight: 600;
        }

        .social-links {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .social-link {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(145deg, #f0f0f0, #ffffff);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #667eea;
            font-size: 1.3rem;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 5px 5px 10px #d9d9d9, -5px -5px 10px #ffffff;
            text-decoration: none;
        }

        .social-link:hover {
            transform: translateY(-8px) scale(1.1);
            background: var(--primary-gradient);
            color: white;
            box-shadow: 0 15px 30px rgba(102, 126, 234, 0.4);
        }

        .edit-profile-btn {
            background: var(--primary-gradient);
            color: white;
            border: none;
            padding: 1rem 2rem;
            border-radius: 15px;
            font-weight: 600;
            font-size: 1.1rem;
            width: 100%;
            margin-top: 2rem;
            transition: all 0.4s ease;
            cursor: pointer;
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
            display: inline-block;
            text-align: center;
            text-decoration: none;
        }

        .edit-profile-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(102, 126, 234, 0.4);
            color: white;
        }

        .recent-booking {
            padding: 1.2rem;
            border: 1px solid #f0f0f0;
            border-radius: 20px;
            margin-bottom: 1rem;
            transition: all 0.4s ease;
            background: white;
        }

        .recent-booking:hover {
            transform: translateX(15px) scale(1.02);
            border-color: #667eea;
            box-shadow: var(--shadow-md);
        }

        .recent-booking-title {
            font-weight: 700;
            color: #333;
            font-size: 1.1rem;
            margin-bottom: 0.3rem;
        }

        .recent-booking-date {
            font-size: 0.9rem;
            color: #888;
        }

        .recent-booking-date i {
            margin-right: 5px;
            color: #667eea;
        }

        .recent-booking-price {
            color: #667eea;
            font-weight: 700;
            font-size: 1.2rem;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .empty-state {
            text-align: center;
            padding: 3rem;
            animation: bounceIn 1s ease;
        }

        @keyframes bounceIn {
            0% { opacity: 0; transform: scale(0.3); }
            50% { opacity: 1; transform: scale(1.05); }
            70% { transform: scale(0.9); }
            100% { transform: scale(1); }
        }

        .empty-state i {
            font-size: 4rem;
            color: #667eea;
            margin-bottom: 1rem;
            animation: float 3s ease-in-out infinite;
        }

        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
        }

        .toast-custom {
            background: white;
            border-radius: 16px;
            padding: 1rem 1.5rem;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            border-left: 4px solid #4ade80;
            animation: slideInRight 0.5s ease;
            display: flex;
            align-items: center;
            gap: 1rem;
            min-width: 300px;
        }

        .toast-custom i {
            font-size: 1.5rem;
            color: #4ade80;
        }

        @media (max-width: 1024px) {
            .profile-content {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            .profile-stats {
                gap: 1.5rem;
            }
            .stat-item {
                padding: 1.2rem 2rem;
                min-width: 150px;
            }
        }

        @media (max-width: 768px) {
            .profile-header {
                padding: 2.5rem 1rem;
            }
            .profile-avatar-container {
                width: 140px;
                height: 140px;
            }
            .profile-name {
                font-size: 2.2rem;
            }
            .profile-stats {
                flex-direction: column;
                align-items: center;
                gap: 1rem;
            }
            .stat-item {
                width: 100%;
                max-width: 300px;
            }
            .profile-sidebar,
            .profile-main {
                padding: 1.5rem;
            }
        }

        @media (max-width: 480px) {
            .profile-avatar-container {
                width: 120px;
                height: 120px;
            }
            .profile-name {
                font-size: 1.8rem;
            }
            .profile-email {
                font-size: 1rem;
            }
            .section-title {
                font-size: 1.2rem;
            }
        }

        ::-webkit-scrollbar {
            width: 10px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(135deg, #764ba2, #667eea);
        }
    </style>
</head>
<body>

    <div class="floating-orb orb-1"></div>
    <div class="floating-orb orb-2"></div>

    <div class="toast-container" id="toastContainer" style="display: none;">
        <div class="toast-custom">
            <i class="fas fa-check-circle"></i>
            <div>
                <strong>Success!</strong>
                <p class="mb-0" id="toastMessage">Profile picture updated successfully!</p>
            </div>
        </div>
    </div>

    <div class="profile-container">
        <div class="profile-header text-center">
            <div class="profile-avatar-container">
                <!-- Dynamic avatar from user data with fallback - PERFECT FIT -->
                <img src="<%= user?.profilePicture || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user?.username || 'User') + '&size=180&background=667eea&color=fff&bold=true' %>" 
                     alt="Profile" 
                     class="profile-avatar"
                     id="profileAvatar">
                
                <div class="avatar-upload-overlay" title="Change Profile Picture" id="avatarUploadOverlay">
                    <i class="fas fa-camera"></i>
                    <input type="file" id="avatarInput" accept="image/*">
                </div>
                
                <span class="avatar-badge"></span>
            </div>
            
            <!-- Dynamic username from logged in user -->
            <h1 class="profile-name"><%= user?.username || 'User' %></h1>
            <div class="profile-email">
                <i class="far fa-envelope me-2"></i><%= user?.email || 'user@example.com' %>
            </div>
            
            <div class="profile-stats">
                <div class="stat-item">
                    <span class="stat-number"><%= totalBookings || 0 %></span>
                    <span class="stat-label">Total Bookings</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number"><%= totalListings || 0 %></span>
                    <span class="stat-label">Properties</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number"><%= user?.createdAt ? new Date(user.createdAt).getFullYear() : '2024' %></span>
                    <span class="stat-label">Member Since</span>
                </div>
            </div>
        </div>

        <div class="profile-content">
            <div class="profile-sidebar">
                <div class="info-section">
                    <h3 class="section-title">
                        <i class="fas fa-user me-2"></i>Personal Information
                    </h3>
                    <div class="info-item">
                        <div class="info-label">Username</div>
                        <div class="info-value"><%= user?.username || 'Not provided' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Email</div>
                        <div class="info-value"><%= user?.email || 'Not provided' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Phone Number</div>
                        <div class="info-value"><%= user?.phone || 'Not provided' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Member Since</div>
                        <div class="info-value"><%= user?.createdAt ? new Date(user.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'Not provided' %></div>
                    </div>
                </div>

                <div class="info-section mt-4">
                    <h3 class="section-title">
                        <i class="fas fa-map-marker-alt me-2"></i>Address
                    </h3>
                    <% if (user?.address) { %>
                        <div class="info-value">
                            <i class="fas fa-home me-2" style="color: #667eea;"></i>
                            <%= user.address.street || '' %><br>
                            <span class="ms-4"><%= user.address.city || '' %>, <%= user.address.state || '' %></span><br>
                            <span class="ms-4"><%= user.address.country || '' %> - <%= user.address.zipCode || '' %></span>
                        </div>
                    <% } else { %>
                        <div class="info-value text-muted">
                            <i class="fas fa-exclamation-circle me-2"></i>No address provided
                        </div>
                    <% } %>
                </div>

                <div class="info-section mt-4">
                    <h3 class="section-title">
                        <i class="fas fa-cog me-2"></i>Preferences
                    </h3>
                    <div class="info-item">
                        <div class="info-label">Language</div>
                        <div class="info-value"><%= user?.preferences?.language || 'English' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Currency</div>
                        <div class="info-value"><%= user?.preferences?.currency || 'INR' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Email Notifications</div>
                        <div class="info-value">
                            <span class="badge <%= user?.preferences?.notifications?.email !== false ? 'bg-success' : 'bg-secondary' %>">
                                <%= user?.preferences?.notifications?.email !== false ? 'Enabled' : 'Disabled' %>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="info-section mt-4">
                    <h3 class="section-title">
                        <i class="fas fa-share-alt me-2"></i>Social Links
                    </h3>
                    <div class="social-links">
                        <a href="<%= user?.socialLinks?.website || '#' %>" target="_blank" class="social-link" title="Website">
                            <i class="fas fa-globe"></i>
                        </a>
                        <a href="<%= user?.socialLinks?.facebook || '#' %>" target="_blank" class="social-link" title="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="<%= user?.socialLinks?.twitter || '#' %>" target="_blank" class="social-link" title="Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="<%= user?.socialLinks?.instagram || '#' %>" target="_blank" class="social-link" title="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </div>
                </div>

                <a href="/profile/edit" class="edit-profile-btn">
                    <i class="fas fa-edit me-2"></i>Edit Profile
                </a>
            </div>

            <div class="profile-main">
                <div class="info-section">
                    <h3 class="section-title">
                        <i class="fas fa-info-circle me-2"></i>About Me
                    </h3>
                    <p class="info-value"><%= user?.bio || 'No bio provided' %></p>
                </div>

                <div class="info-section mt-4">
                    <h3 class="section-title">
                        <i class="fas fa-calendar-check me-2"></i>Recent Bookings
                    </h3>
                    <% if (recentBookings && recentBookings.length > 0) { %>
                        <% recentBookings.forEach(booking => { %>
                            <div class="recent-booking">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="recent-booking-title">
                                            <i class="fas fa-home me-2" style="color: #667eea;"></i>
                                            <%= booking.listing?.title || 'Unknown Listing' %>
                                        </div>
                                        <div class="recent-booking-date">
                                            <i class="far fa-calendar-alt"></i>
                                            <%= new Date(booking.checkIn).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %> - 
                                            <%= new Date(booking.checkOut).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                        </div>
                                        <div class="recent-booking-date">
                                            <i class="fas fa-user-friends"></i>
                                            <%= booking.adults || 0 %> Adults <%= booking.children > 0 ? `, ${booking.children} Children` : '' %>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="recent-booking-price">
                                            ₹<%= booking.totalPrice?.toLocaleString('en-IN') || '0' %>
                                        </div>
                                        <span class="badge <%= booking.paymentStatus === 'Paid' ? 'bg-success' : 'bg-warning' %>">
                                            <%= booking.paymentStatus || 'Pending' %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                        <div class="text-center mt-4">
                            <a href="/listings/mybooking" class="btn btn-outline-primary">
                                <i class="fas fa-eye me-2"></i>View All Bookings
                                <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-calendar-times"></i>
                            <h4>No Bookings Yet</h4>
                            <p class="text-muted">Start exploring and book your first stay!</p>
                            <a href="/listings" class="btn btn-primary mt-3">
                                <i class="fas fa-compass me-2"></i>Explore Listings
                            </a>
                        </div>
                    <% } %>
                </div>

                <% if (recentBookings && recentBookings.length > 0) { %>
                <div class="info-section mt-4">
                    <h3 class="section-title">
                        <i class="fas fa-chart-line me-2"></i>Activity Overview
                    </h3>
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="p-3">
                                <i class="fas fa-suitcase fa-2x mb-2" style="color: #667eea;"></i>
                                <h5><%= totalBookings || 0 %></h5>
                                <small class="text-muted">Total Trips</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3">
                                <i class="fas fa-clock fa-2x mb-2" style="color: #764ba2;"></i>
                                <h5><%= recentBookings?.length || 0 %></h5>
                                <small class="text-muted">Upcoming</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3">
                                <i class="fas fa-star fa-2x mb-2" style="color: #f093fb;"></i>
                                <h5>4.8</h5>
                                <small class="text-muted">Rating</small>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Get current user from server-side data
        const currentUser = {
            username: '<%= user?.username || "User" %>',
            email: '<%= user?.email || "user@example.com" %>',
            profilePicture: '<%= user?.profilePicture || "" %>'
        };

        // ===== PROFILE PICTURE UPLOAD =====
        const avatarInput = document.getElementById('avatarInput');
        const profileAvatar = document.getElementById('profileAvatar');
        const toastContainer = document.getElementById('toastContainer');
        const toastMessage = document.getElementById('toastMessage');

        function showToast(message, isSuccess = true) {
            toastContainer.style.display = 'block';
            toastMessage.textContent = message;
            const toast = toastContainer.querySelector('.toast-custom');
            toast.style.borderLeftColor = isSuccess ? '#4ade80' : '#f5576c';
            toast.querySelector('i').style.color = isSuccess ? '#4ade80' : '#f5576c';
            
            setTimeout(() => {
                toastContainer.style.display = 'none';
            }, 4000);
        }

        // Click handler for avatar upload
        document.getElementById('avatarUploadOverlay').addEventListener('click', function(e) {
            const input = this.querySelector('input[type="file"]');
            if (input) {
                e.stopPropagation();
                input.click();
            }
        });

        document.querySelector('.avatar-upload-overlay i').addEventListener('click', function(e) {
            e.stopPropagation();
            const input = document.getElementById('avatarInput');
            if (input) {
                input.click();
            }
        });

        // Handle file selection - SAVE TO LOCAL STORAGE
        avatarInput.addEventListener('change', function(e) {
            e.stopPropagation();
            const file = this.files[0];
            
            if (!file) return;
            
            if (!file.type.startsWith('image/')) {
                showToast('Please select a valid image file!', false);
                this.value = '';
                return;
            }
            
            if (file.size > 5 * 1024 * 1024) {
                showToast('Image size must be less than 5MB!', false);
                this.value = '';
                return;
            }

            const reader = new FileReader();
            reader.onload = function(event) {
                const imageData = event.target.result;
                profileAvatar.src = imageData;
                // Save to localStorage for persistence
                localStorage.setItem('profilePicture_' + currentUser.username, imageData);
                showToast('Profile picture updated successfully! 🎉');
            };
            reader.onerror = function() {
                showToast('Failed to read image file. Please try again.', false);
            };
            reader.readAsDataURL(file);
            
            this.value = '';
        });

        // Load saved profile picture from localStorage
        function loadSavedProfilePicture() {
            const savedImage = localStorage.getItem('profilePicture_' + currentUser.username);
            if (savedImage) {
                profileAvatar.src = savedImage;
            }
        }
        loadSavedProfilePicture();

        // ===== Animate stats on scroll =====
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.stat-item, .info-item, .recent-booking').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'all 0.6s ease';
            observer.observe(el);
        });

        // ===== Drag and Drop support =====
        const avatarContainer = document.querySelector('.profile-avatar-container');
        
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            avatarContainer.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
            });
        });

        avatarContainer.addEventListener('dragover', () => {
            avatarContainer.style.transform = 'scale(1.02)';
        });

        avatarContainer.addEventListener('dragleave', () => {
            avatarContainer.style.transform = 'scale(1)';
        });

        avatarContainer.addEventListener('drop', (e) => {
            avatarContainer.style.transform = 'scale(1)';
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                const file = files[0];
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        const imageData = event.target.result;
                        profileAvatar.src = imageData;
                        localStorage.setItem('profilePicture_' + currentUser.username, imageData);
                        showToast('Profile picture updated via drag & drop! 🎉');
                    };
                    reader.readAsDataURL(file);
                } else {
                    showToast('Please drop an image file!', false);
                }
            }
        });

        console.log('✅ Profile loaded for user: ' + currentUser.username);
    });
    </script>

</body>
</html>
