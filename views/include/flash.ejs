<style>
/* ===== Animated Alerts ===== */

.alert{
  border-radius:15px;
  font-weight:500;
  animation:slideFade 0.6s ease;
  transition:0.4s ease;
  position:relative;
  overflow:hidden;
}

/* Slide + Fade animation */
@keyframes slideFade{
  from{
    transform:translateY(-20px);
    opacity:0;
  }
  to{
    transform:translateY(0);
    opacity:1;
  }
}

/* Hover lift effect */
.alert:hover{
  transform:translateY(-4px);
  box-shadow:0 12px 30px rgba(0,0,0,0.2);
}

/* Success glow */
.alert-success{
  box-shadow:0 0 15px rgba(25,135,84,0.3);
}

/* Error glow */
.alert-danger{
  box-shadow:0 0 15px rgba(220,53,69,0.3);
}

/* Close button animation */
.btn-close{
  transition:0.3s ease;
}

.btn-close:hover{
  transform:rotate(90deg) scale(1.2);
}
</style>


<!-- this for success -->
<% if(success && success.length){ %>
<div class="alert alert-success alert-dismissible fade show col-6 offset-2" role="alert">
  <%=success%>

 <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%}%>

<!-- this is for failure -->
 
<% if(error && error.length){ %>
<div class="alert alert-danger alert-dismissible fade show col-6 offset-2" role="alert">
  <%=error%>

 <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%}%>
