<style>
/* ===== Wanderlust Premium Animated Footer ===== */

.wl-footer {
    background: linear-gradient(-45deg,#111,#1a1a1a,#000,#111);
    background-size:400% 400%;
    animation:footerBG 18s ease infinite;
    font-size:14px;
    position:relative;
    overflow:hidden;
}

/* Background animation */
@keyframes footerBG{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
}

/* Fade Up Animation */
.wl-footer .row > div{
    opacity:0;
    transform:translateY(40px);
    animation:fadeUp 1s ease forwards;
}

.wl-footer .row > div:nth-child(1){animation-delay:0.2s;}
.wl-footer .row > div:nth-child(2){animation-delay:0.4s;}
.wl-footer .row > div:nth-child(3){animation-delay:0.6s;}
.wl-footer .row > div:nth-child(4){animation-delay:0.8s;}

@keyframes fadeUp{
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* Headings glow */
.wl-footer h5,
.wl-footer h6{
    letter-spacing:1px;
    transition:0.3s ease;
}

.wl-footer h5:hover,
.wl-footer h6:hover{
    text-shadow:0 0 10px #ffc107;
}

/* Quick Link Buttons */
.wl-footer .btn{
    transition:0.3s ease;
}

.wl-footer .btn:hover{
    transform:translateX(6px) scale(1.05);
    box-shadow:0 8px 20px rgba(255,193,7,0.3);
}

/* Social Icons */
.wl-footer .wl-social{
    color:#ccc;
    font-size:18px;
    transition:0.4s ease;
}

.wl-footer .wl-social:hover{
    color:#ffc107;
    transform:translateY(-5px) scale(1.3);
    text-shadow:0 0 15px #ffc107;
}

/* Divider */
.wl-footer hr{
    opacity:0.2;
    animation:expandLine 1.5s ease;
}

@keyframes expandLine{
    from{width:0; opacity:0;}
    to{width:100%; opacity:0.2;}
}

/* Bottom Text Glow */
.wl-footer .text-center{
    transition:0.3s ease;
}

.wl-footer .text-center:hover{
    color:#ffc107;
}
</style>


<footer class="wl-footer text-light pt-5 pb-4 mt-5">
