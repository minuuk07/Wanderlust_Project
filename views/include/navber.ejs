          <a href="/listings/contact" class="btn btn-outline-warning btn-sm text-start">Contact</a>
        </div>
      </div>

      <!-- Support -->
      <div class="col-md-3 mb-4">
        <h6 class="text-warning">Support</h6>
        <div class="d-grid gap-2">
          <a href="/privacy" class="btn btn-outline-warning btn-sm text-start">Privacy Policy</a>
          <a href="/listings/terms" class="btn btn-outline-warning btn-sm text-start">Terms & Conditions</a>
