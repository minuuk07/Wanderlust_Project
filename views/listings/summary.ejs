                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <!-- Expired Bookings (Hidden by default, shown when filter clicked) -->
        <% if (expiredBookings.length > 0) { %>
            <div id="expiredBookings" style="display: none;">
                <% expiredBookings.forEach((booking, index) => { 
                    const checkoutDate = new Date(booking.checkOut);
                    const daysPassed = Math.ceil((today - checkoutDate) / (1000 * 60 * 60 * 24));
                %>
                    <div class="row justify-content-center booking-item expired-booking">
                        <div class="col-md-10 mb-4">
                            <div class="booking-card expired">
                                <!-- Expired Badge -->
                                <div class="expired-badge">
                                    <i class="fas fa-hourglass-end me-1"></i>
                                    Expired
                                </div>

                                <!-- Card Header -->
                                <div class="card-header">
                                    <span class="booking-number">
                                        <i class="fas fa-hashtag me-1"></i>
                                        Booking #<%= bookings.length - index %>
                                    </span>
                                    <span class="booking-status status-expired">
                                        <i class="fas fa-circle me-1" style="font-size: 0.6rem;"></i>
                                        Expired
                                    </span>
                                </div>

                                <!-- Listing Title -->
                                <h2 class="listing-title" style="opacity: 0.7;">
                                    <i class="fas fa-home me-2"></i>
                                    <%= booking.listing?.title || 'Unknown Property' %>
                                </h2>

                                <!-- Decorative Line -->
                                <div class="decorative-line" style="opacity: 0.5;"></div>

                                <!-- Info Grid -->
                                <div class="info-grid">
                                    <div class="info-item">
                                        <div class="info-label">
                                            <i class="fas fa-user"></i> Guest Name
                                        </div>
                                        <div class="info-value">
                                            <%= booking.name %>
                                        </div>
                                    </div>
                                    
                                    <div class="info-item">
                                        <div class="info-label">
                                            <i class="fas fa-calendar-alt"></i> Check Out
                                        </div>
                                        <div class="info-value">
                                            <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { 
                                                day: 'numeric', 
                                                month: 'short', 
                                                year: 'numeric' 
                                            }) %>
                                            <span class="badge bg-secondary ms-2"><%= daysPassed %> days ago</span>
                                        </div>
                                    </div>
                                    
                                    <div class="info-item">
                                        <div class="info-label">
                                            <i class="fas fa-moon"></i> Duration
                                        </div>
                                        <div class="info-value">
                                            <strong><%= booking.totalDays || 1 %></strong> nights
                                        </div>
                                    </div>
                                    
                                    <div class="info-item">
                                        <div class="info-label">
                                            <i class="fas fa-user-friends"></i> Guests
                                        </div>
                                        <div class="info-value">
                                            <%= booking.adults || 0 %> Adults
                                            <% if(booking.children > 0) { %>
                                                , <%= booking.children %> Children
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Price Section (Grayscale) -->
                                <div class="price-section" style="background: linear-gradient(135deg, #6c757d, #495057);">
                                    <span class="price-label">
                                        <i class="fas fa-credit-card me-2"></i>
                                        Total Paid
                                    </span>
                                    <span class="price-value">
                                        ₹ <%= (booking.totalPrice || 0).toLocaleString('en-IN') %>
                                    </span>
                                </div>

                                <!-- Action Buttons for Expired -->
                                <div class="button-group">
                                    <a href="/listings/<%= booking.listing?._id %>" class="btn btn-secondary">
                                        <i class="fas fa-eye me-2"></i>
                                        View Property
                                    </a>
                                    
                                    <a href="/listings/<%= booking.listing?._id %>/booking" class="btn btn-primary">
                                        <i class="fas fa-redo me-2"></i>
                                        Book Again
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <!-- Auto-hide expired bookings message -->
        <% if (expiredBookings.length > 0) { %>
            <div class="alert alert-info text-center" style="background: rgba(255,255,255,0.9); border-radius: 15px; padding: 1rem; margin-top: 1rem;">
                <i class="fas fa-info-circle me-2"></i>
                <%= expiredBookings.length %> expired booking<%= expiredBookings.length > 1 ? 's' : '' %> automatically hidden. 
                <a href="#" onclick="showExpiredBookings(); return false;" style="color: #667eea; font-weight: 600;">Click here to view</a>
            </div>
        <% } %>
        
    <% } else { %>
        <!-- Empty State -->
        <div class="empty-state">
            <i class="fas fa-calendar-times"></i>
            <h2>No Bookings Found</h2>
            <p>You haven't made any bookings yet. Start planning your next adventure!</p>
            <a href="/listings" class="btn btn-primary" style="padding: 1rem 3rem; font-size: 1.2rem;">
                <i class="fas fa-compass me-2"></i>
                Explore Properties
                <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    <% } %>
</div>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<!-- JavaScript for Auto-hide Expired Bookings and Filtering -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Auto-hide expired bookings on page load
    checkExpiredBookings();
    
    // Set interval to check every minute
    setInterval(checkExpiredBookings, 60000);
    
    // Add smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            document.querySelector(this.getAttribute('href')).scrollIntoView({
                behavior: 'smooth'
            });
        });
    });

    // Add scroll reveal animation
    const cards = document.querySelectorAll('.booking-card');
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0) scale(1)';
            }
        });
    }, { threshold: 0.1 });

    cards.forEach(card => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(30px) scale(0.95)';
        card.style.transition = 'all 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        observer.observe(card);
    });

    // Add hover effects
    cards.forEach(card => {
        card.addEventListener('mouseenter', function() {
            if (!this.classList.contains('expired')) {
                this.style.transform = 'translateY(-10px) scale(1.02)';
            }
        });
        
        card.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0) scale(1)';
        });
    });

    // Filter buttons active state
    const filterAll = document.getElementById('filterAll');
    const filterActive = document.getElementById('filterActive');
    const filterExpired = document.getElementById('filterExpired');
    
    if (filterAll) {
        filterAll.classList.add('active');
    }
});

// Function to check and hide expired bookings
function checkExpiredBookings() {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    
    document.querySelectorAll('.booking-card').forEach(card => {
        const checkoutElement = card.querySelector('.info-item:nth-child(4) .info-value');
        if (checkoutElement) {
            const checkoutText = checkoutElement.innerText;
            // Parse date from text (assuming format like "Mon, 15 Mar 2026")
            const dateMatch = checkoutText.match(/\d{1,2}\s\w+\s\d{4}/);
            if (dateMatch) {
                const checkoutDate = new Date(dateMatch[0]);
                checkoutDate.setHours(0, 0, 0, 0);
                
                if (checkoutDate < today) {
                    // Booking is expired
                    card.closest('.booking-item').classList.add('expired-item');
                    
                    // If currently showing all or active, hide expired ones
                    const activeFilter = document.querySelector('.filter-btn.active')?.id;
                    if (activeFilter === 'filterAll') {
                        // In all view, mark as expired but don't hide
                        card.classList.add('expired');
                    } else if (activeFilter === 'filterActive') {
                        // In active view, hide expired
                        card.closest('.booking-item').style.display = 'none';
                    }
                }
            }
        }
    });
}

// Filter bookings by type
function filterBookings(type) {
    // Update active button
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('active');
    });
    document.getElementById(`filter${type.charAt(0).toUpperCase() + type.slice(1)}`).classList.add('active');
    
    const activeBookings = document.querySelectorAll('.active-booking');
    const expiredBookings = document.querySelectorAll('.expired-booking');
    
    if (type === 'all') {
        // Show all bookings
        activeBookings.forEach(item => item.style.display = '');
        expiredBookings.forEach(item => item.style.display = '');
    } else if (type === 'active') {
        // Show only active bookings
        activeBookings.forEach(item => item.style.display = '');
        expiredBookings.forEach(item => item.style.display = 'none');
    } else if (type === 'expired') {
        // Show only expired bookings
        activeBookings.forEach(item => item.style.display = 'none');
        expiredBookings.forEach(item => item.style.display = '');
    }
}

// Show expired bookings (called from alert link)
function showExpiredBookings() {
    filterBookings('expired');
}

// Function to manually remove expired bookings
function removeExpiredBookings() {
    if (confirm('Are you sure you want to remove all expired bookings from view?')) {
        document.querySelectorAll('.expired-booking').forEach(item => {
            item.style.display = 'none';
        });
        
        // Show success message
        const toast = document.createElement('div');
        toast.className = 'alert alert-success position-fixed top-0 start-50 translate-middle-x mt-3';
        toast.style.zIndex = '9999';
        toast.style.animation = 'slideDown 0.5s ease';
        toast.innerHTML = '<i class="fas fa-check-circle me-2"></i>Expired bookings removed';
        document.body.appendChild(toast);
        
        setTimeout(() => toast.remove(), 3000);
    }
}

// Add keyframe for toast animation
const style = document.createElement('style');
style.textContent = `
    @keyframes slideDown {
        from { transform: translateY(-100%) translateX(-50%); }
        to { transform: translateY(0) translateX(-50%); }
    }
    
    @keyframes fall {
        to {
            transform: translateY(100vh) rotate(720deg);
        }
    }
`;
document.head.appendChild(style);

// Confetti effect for paid bookings (optional)
document.addEventListener('DOMContentLoaded', function() {
    const paidBookings = document.querySelectorAll('.status-paid');
    if (paidBookings.length > 0 && Math.random() > 0.7) { // 30% chance
        for (let i = 0; i < 50; i++) {
            setTimeout(() => {
                const confetti = document.createElement('div');
                confetti.style.position = 'fixed';
                confetti.style.left = Math.random() * 100 + '%';
                confetti.style.top = '-10px';
                confetti.style.width = '8px';
                confetti.style.height = '8px';
                confetti.style.background = `hsl(${Math.random() * 360}, 100%, 50%)`;
                confetti.style.borderRadius = '50%';
                confetti.style.zIndex = '9999';
                confetti.style.pointerEvents = 'none';
                confetti.style.animation = `fall ${Math.random() * 3 + 2}s linear`;
                document.body.appendChild(confetti);
                
                setTimeout(() => confetti.remove(), 5000);
            }, i * 50);
        }
    }
});
</script>
