                                            <i class="fas fa-moon"></i> Duration
                                        </div>
                                        <div class="info-value">
                                            <strong><%= booking.totalDays || 1 %></strong> nights
                                        </div>
                                    </div>
                                    
                                    <div class="info-item">
                                        <div class="info-label">
                                            <i class="fas fa-user-friends"></i> Guests
                                        </div>
                                        <div class="info-value">
                                            <%= booking.adults || 0 %> Adults
                                            <% if(booking.children > 0) { %>
                                                , <%= booking.children %> Children
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <div class="info-item">
                                        <div class="info-label">
                                            <i class="fas fa-tag"></i> Booking ID
                                        </div>
                                        <div class="info-value" style="font-size: 0.9rem;">
                                            <%= booking._id.toString().substring(0, 15) %>...
                                        </div>
                                    </div>
                                    
                                    <div class="info-item">
                                        <div class="info-label">
                                            <i class="far fa-clock"></i> Booked On
                                        </div>
                                        <div class="info-value">
                                            <%= new Date(booking.createdAt).toLocaleDateString('en-IN', { 
                                                day: 'numeric', 
                                                month: 'short', 
                                                year: 'numeric' 
                                            }) %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Price Section -->
                                <div class="price-section">
                                    <span class="price-label">
                                        <i class="fas fa-credit-card me-2"></i>
                                        Total Amount
                                    </span>
                                    <span class="price-value">
                                        ₹ <%= (booking.totalPrice || 0).toLocaleString('en-IN') %>
                                    </span>
                                </div>

                                <!-- Action Buttons -->
                                <div class="button-group">
                                    <a href="/listings/<%= booking.listing?._id %>" class="btn btn-primary">
                                        <i class="fas fa-eye me-2"></i>
                                        View Property
                                    </a>
                                    
                                    <a href="/listings" class="btn btn-secondary">
                                        <i class="fas fa-compass me-2"></i>
                                        Browse More
                                    </a>

                                    <% if (booking.paymentStatus?.toLowerCase() === 'pending') { %>
                                        <a href="/listings/<%= booking._id %>/upi" class="btn btn-danger">
                                            <i class="fas fa-credit-card me-2"></i>
