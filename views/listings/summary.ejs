<% layout("/layout/boilerplate") %>

<style>
  body{
    background: linear-gradient(-45deg,#f8f9fa,#e9f7ef,#ffffff,#f1f3f6);
    background-size:400% 400%;
    animation:bgMove 14s ease infinite;
  }

  @keyframes bgMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
  }

  .card{
    border-radius:1.5rem;
    transform:translateY(50px);
    opacity:0;
    animation:fadeUp 1s ease forwards;
    transition:0.4s ease;
  }

  @keyframes fadeUp{
    to{
      transform:translateY(0);
      opacity:1;
    }
  }

  .card:hover{
    transform:translateY(-8px);
    box-shadow:0 25px 50px rgba(0,0,0,0.2);
  }

  h2{
    animation:glowText 2s infinite alternate;
  }

  @keyframes glowText{
    from{ text-shadow:0 0 5px rgba(25,135,84,0.3); }
    to{ text-shadow:0 0 20px rgba(25,135,84,0.7); }
  }

  hr{
    animation:expandLine 1s ease;
  }

  @keyframes expandLine{
    from{width:0; opacity:0;}
    to{width:100%; opacity:1;}
  }

  .mb-2{
    transition:0.3s ease;
    padding:6px 0;
  }

  .mb-2:hover{
    transform:translateX(6px);
    color:#198754;
  }

  h4{
    animation:pulseAmount 2s infinite;
  }

  @keyframes pulseAmount{
    0%{transform:scale(1);}
    50%{transform:scale(1.05);}
    100%{transform:scale(1);}
  }

  .btn{
    border-radius:50rem;
    transition:0.3s ease;
  }

  .btn:hover{
    transform:scale(1.08);
    box-shadow:0 10px 25px rgba(0,0,0,0.25);
  }
</style>


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg border-0 rounded-4 p-4">

                <h2 class="text-success text-center mb-3">
                    🧾 Booking Summary
                </h2>

                <hr>

                <div class="mb-2">
                    <strong>Listing:</strong> <%= booking.listing.title %>
                </div>

                <div class="mb-2">
                    <strong>Name:</strong> <%= booking.name %>
                </div>

                <div class="mb-2">
                    <strong>Email:</strong> <%= booking.email %>
                </div>

                <div class="mb-2">
                    <strong>Check In:</strong> 
                    <%= booking.checkIn.toDateString() %>
                </div>

                <div class="mb-2">
                    <strong>Check Out:</strong> 
                    <%= booking.checkOut.toDateString() %>
                </div>

                <div class="mb-2">
                    <strong>Total Nights:</strong> 
                    <%= booking.totalDays > 0 ? booking.totalDays : 1 %>
                </div>

                <h4 class="text-danger mt-3">
                    Total Amount: ₹
                    <%= booking.totalPrice > 0 ? booking.totalPrice : 500 %>
                </h4>

                <!-- ✅ Buttons Section -->
                <div class="d-flex justify-content-center gap-3 mt-4">

                    <a href="/listings"
                       class="btn btn-outline-secondary px-4">
                       Back to Listings
                    </a>

                </div>

            </div>
        </div>
    </div>
</div>
