<% layout("/layout/boilerplate") %>

<div class="row mt-4">
  <div class="col-10 offset-1 text-center">
    <h1>Wanderlust — Explore top stays</h1>
    <p class="lead">Handpicked places to stay. Search, book and explore.</p>
    <a href="/listings" class="btn btn-lg btn-search">Browse all listings</a>
  </div>
</div>

<!-- Filters / icons (optional; copied style from index) -->
<div class="row mt-4">
  <div class="col-10 offset-1 d-flex justify-content-between align-items-center">
    <div class="filter"><i class="fa-solid fa-house"></i> <span>Homes</span></div>
    <div class="filter"><i class="fa-solid fa-tree"></i> <span>Nature</span></div>
    <div class="filter"><i class="fa-solid fa-city"></i> <span>City</span></div>
    <div class="filter"><i class="fa-solid fa-sailboat"></i> <span>Boats</span></div>
  </div>
</div>

<!-- Listing grid: same structure used in your listings index -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for (let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-list">
      <div class="card col listing-card">
        <img src="<%= listing.image && listing.image.url ? listing.image.url : '/images/placeholder.jpg' %>" 
             class="card-img-top" alt="listing-image" style="height: 20rem;">
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <b><p class="card-text"><%= listing.title %><br></b>
          &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>/Night
          <i class="tax-info"> &nbsp; &nbsp +18% GST</i>
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>
