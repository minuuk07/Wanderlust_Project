<% layout("/layout/boilerplate") %>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wanderlust - Login & Signup</title>

    <!-- Bootstrap 5 + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        /* ---------- RESET & BASE ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(-45deg, #fff3cd, #f8f9fa, #ffffff, #fff8e1);
            background-size: 400% 400%;
            animation: bgMove 14s ease infinite;
        }

        @keyframes bgMove {
            0%   { background-position: 0% 50%; }
            50%  { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* ---------- COVER / HERO ---------- */
        .cover {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .cover-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
        }

        .cover-overlay {
            position: relative;
            z-index: 1;
            width: 100%;
            padding: 3rem 1rem;
            background: rgba(0, 0, 0, 0.30);
            backdrop-filter: blur(3px);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* ---------- HERO TEXT ---------- */
        .hero-title {
            font-size: clamp(2.2rem, 8vw, 4.8rem);
            font-weight: 800;
            animation: glowText 2.5s infinite alternate;
            color: #fff;
            text-shadow: 0 4px 30px rgba(0,0,0,0.3);
        }

        .hero-sub {
            font-size: clamp(1rem, 3vw, 1.8rem);
            color: rgba(255,255,255,0.95);
            margin-bottom: 2rem;
            font-weight: 300;
            letter-spacing: 1px;
        }

        @keyframes glowText {
            from { text-shadow: 0 0 10px rgba(255, 193, 7, 0.3); }
            to   { text-shadow: 0 0 40px rgba(255, 193, 7, 0.7), 0 0 80px rgba(255, 193, 7, 0.3); }
        }

        /* ---------- CARDS ---------- */
        .auth-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border-radius: 2rem !important;
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.20);
            transform: translateY(40px);
            opacity: 0;
            animation: fadeUp 0.9s ease forwards;
            transition: 0.4s ease;
        }

        .auth-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 35px 80px rgba(0, 0, 0, 0.25);
        }

        @keyframes fadeUp {
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .auth-card .card-title {
            font-size: 2rem;
            font-weight: 700;
            color: #f0a500;
            letter-spacing: 0.5px;
        }

        /* ---------- FORM ELEMENTS ---------- */
        .form-control {
            border-radius: 14px;
            border: 2px solid #e9ecef;
            padding: 0.8rem 1.2rem;
            transition: 0.3s ease;
            font-size: 1rem;
        }

        .form-control:focus {
            transform: scale(1.02);
            border-color: #ffc107;
            box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
            background-color: #fffef7;
        }

        .form-label {
            font-weight: 600;
            color: #1a1a2e;
            font-size: 0.95rem;
        }

        .form-label i {
            margin-right: 6px;
            color: #f0a500;
        }

        /* ---------- BUTTONS ---------- */
        .btn-wanderlust {
            border-radius: 50rem;
            padding: 0.8rem 2rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            transition: 0.3s ease;
            border: none;
            background: #ffc107;
            color: #1a1a1a;
        }

        .btn-wanderlust:hover {
            transform: scale(1.06);
            box-shadow: 0 12px 35px rgba(255, 193, 7, 0.45);
            background: #ffb300;
            color: #000;
        }

        .btn-wanderlust i {
            margin-right: 8px;
        }

        /* ---------- FORGOT PASSWORD LINK (block) ---------- */
        .reset-block {
            display: block;
            width: 100%;
            text-align: center;
            padding: 0.8rem 0;
            margin: 1rem 0;
            border-radius: 50rem;
            background: #ffc107;
            color: #000;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            border: none;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        }

        .reset-block:hover {
            background: #ff9800;
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
            color: #000;
        }

        .reset-block::before {
            content: "";
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,0.5), transparent);
            transition: 0.6s;
        }

        .reset-block:hover::before {
            left: 100%;
        }

        .reset-block i {
            margin-right: 8px;
        }

        /* ---------- SWITCH LINK ---------- */
        .switch-link {
            color: #f0a500;
            font-weight: 700;
            text-decoration: none;
            transition: 0.2s;
        }

        .switch-link:hover {
            color: #e68900;
            text-decoration: underline;
        }

        /* ---------- VALIDATION ---------- */
        .valid-feedback,
        .invalid-feedback {
            font-size: 0.85rem;
        }

        /* ---------- RESPONSIVE ---------- */
        @media (max-width: 576px) {
            .auth-card .card-body {
                padding: 1.8rem !important;
            }
            .auth-card .card-title {
                font-size: 1.6rem;
            }
            .reset-block {
                font-size: 0.9rem;
                padding: 0.65rem 0;
            }
        }

        @media (min-width: 992px) {
            .auth-card {
                min-width: 420px;
            }
        }
    </style>
</head>
<body>

    <div class="cover">
        <!-- Background Image -->
        <img
            class="cover-bg"
            src="https://images.ctfassets.net/hrltx12pl8hq/28ECAQiPJZ78hxatLTa7Ts/2f695d869736ae3b0de3e56ceaca3958/free-nature-images.jpg?fit=fill&w=1200&h=630"
            alt="Scenic mountain landscape"
            loading="lazy"
        />

        <div class="cover-overlay">
            <div class="container py-4">

                <!-- Hero Section -->
                <div class="text-center mb-5">
                    <h1 class="hero-title">
                    <marquee>    <i class="fas fa-compass me-2" style="color: #ffc107;"></i>WANDERLUST</marquee>
                    </h1>
                    <p class="hero-sub">Explore the world, one journey at a time.</p>
                </div>

                <!-- Cards Row: Login + Signup side by side on large screens -->
                <div class="row g-4 justify-content-center">

                    <!-- ========== LOGIN CARD ========== -->
                    <div class="col-lg-5 col-md-8 col-11">
                        <div class="auth-card card">
                            <div class="card-body p-4 p-md-5">

                                <h2 class="card-title text-center mb-4">
                                    <i class="fas fa-sign-in-alt me-2"></i>Login
                                </h2>

                                <form action="/login" method="POST" novalidate class="needs-validation">

                                    <div class="mb-3">
                                        <label for="login-username" class="form-label">
                                            <i class="fas fa-user"></i>Username
                                        </label>
                                        <input
                                            type="text"
                                            class="form-control form-control-lg"
                                            id="login-username"
                                            name="username"
                                            placeholder="Enter your username"
                                            required
                                            autofocus
                                        />
                                        <div class="valid-feedback">Looks good!</div>
                                        <div class="invalid-feedback">Please enter a valid username.</div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="login-password" class="form-label">
                                            <i class="fas fa-lock"></i>Password
                                        </label>
                                        <input
                                            type="password"
                                            class="form-control form-control-lg"
                                            id="login-password"
                                            name="password"
                                            placeholder="Enter your password"
                                            autocomplete="current-password"
                                            required
                                        />
                                        <div class="invalid-feedback">Please enter your password.</div>
                                    </div>

                                    <!-- Forgot Password -->
                                    <a href="/forgot-password" class="reset-block">
                                        <i class="fas fa-key"></i> Forgot Password?
                                    </a>

                                    <!-- Login Button -->
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-wanderlust btn-lg">
                                            <i class="fas fa-sign-in-alt"></i> Log In
                                        </button>
                                    </div>

                                </form>

                                <p class="text-center text-muted mt-4 mb-0 small">
                                    New here? <a href="#signup-card" class="switch-link">Create an account</a>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- ========== SIGNUP CARD ========== -->
                    <div class="col-lg-5 col-md-8 col-11" id="signup-card">
                        <div class="auth-card card">
                            <div class="card-body p-4 p-md-5">

                                <h2 class="card-title text-center mb-4">
                                    <i class="fas fa-user-plus me-2"></i>Sign Up
                                </h2>

                                <form action="/signup" method="POST" novalidate class="needs-validation">

                                    <div class="mb-3">
                                        <label for="signup-username" class="form-label">
                                            <i class="fas fa-user"></i>Username
                                        </label>
                                        <input
                                            type="text"
                                            class="form-control form-control-lg"
                                            id="signup-username"
                                            name="username"
                                            placeholder="Choose a username"
                                            required
                                        />
                                        <div class="valid-feedback">Available!</div>
                                        <div class="invalid-feedback">Please enter a username.</div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="signup-email" class="form-label">
                                            <i class="fas fa-envelope"></i>Email
                                        </label>
                                        <input
                                            type="email"
                                            class="form-control form-control-lg"
                                            id="signup-email"
                                            name="email"
                                            placeholder="you@example.com"
                                            required
                                        />
                                        <div class="valid-feedback">Valid email!</div>
                                        <div class="invalid-feedback">Please enter a valid email address.</div>
                                    </div>

                                    <div class="mb-4">
                                        <label for="signup-password" class="form-label">
                                            <i class="fas fa-lock"></i>Password
                                        </label>
                                        <input
                                            type="password"
                                            class="form-control form-control-lg"
                                            id="signup-password"
                                            name="password"
                                            placeholder="Create a strong password"
                                            autocomplete="new-password"
                                            required
                                        />
                                        <div class="invalid-feedback">Password is required.</div>
                                    </div>

                                    <!-- Signup Button -->
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-wanderlust btn-lg">
                                            <i class="fas fa-user-plus"></i> Create Account
                                        </button>
                                    </div>

                                </form>

                                <p class="text-center text-muted mt-4 mb-0 small">
                                    Already a member? <a href="#login-card" class="switch-link">Log in</a>
                                </p>
                            </div>
                        </div>
                    </div>

                </div><!-- /row -->
            </div><!-- /container -->
        </div><!-- /cover-overlay -->
    </div><!-- /cover -->

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <!-- Form Validation Script -->
    <script>
        (function() {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(function(form) {
                form.addEventListener('submit', function(event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>

</body>
</html>