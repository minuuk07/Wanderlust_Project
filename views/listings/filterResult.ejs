<% layout("/layout/boilerplate") %>

<div class="row mt-4 text-center">
  <h2>Showing "<%= category.toUpperCase() %>" Listings</h2>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% if(listings.length === 0) { %>
    <p class="text-center text-danger">No listings found for this category.</p>
  <% } else { %>
    <% for(let listing of listings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-list">
        <div class="card col listing-card">
          <img
            src="<%= listing.image && listing.image.url ? listing.image.url : '/images/placeholder.jpg' %>"
            class="card-img-top"
            alt="listing image"
            style="height: 20rem;"
          />
          <div class="card-body">
            <b><p class="card-text"><%= listing.title %></b><br/>
            ₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / Night
            </p>
          </div>
        </div>
      </a>
    <% } %>
  <% } %>
</div>
