<% layout("/layout/boilerplate") %>

<style>
  body{
    background: linear-gradient(-45deg,#f8f9fa,#eef2f7,#ffffff,#f1f3f6);
    background-size:400% 400%;
    animation: bgMove 12s ease infinite;
  }

  @keyframes bgMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
  }

  .text-center h1{
    animation: fadeDown 1s ease;
  }

  @keyframes fadeDown{
    from{opacity:0; transform:translateY(-30px);}
    to{opacity:1; transform:translateY(0);}
  }

  .card{
    border-radius:18px;
    transition:0.4s ease;
    transform:translateY(40px);
    opacity:0;
    animation: fadeUp 1s ease forwards;
  }

  .card:nth-child(1){animation-delay:0.2s;}
  .card:nth-child(2){animation-delay:0.4s;}

  @keyframes fadeUp{
    to{
      transform:translateY(0);
      opacity:1;
    }
  }

  .card:hover{
    transform:translateY(-8px);
    box-shadow:0 20px 40px rgba(0,0,0,0.2);
  }

  .form-control{
    border-radius:12px;
    transition:0.3s ease;
  }

  .form-control:focus{
    border-color:#ffc107;
    box-shadow:0 0 12px rgba(255,193,7,0.4);
    transform:scale(1.02);
  }

  .btn-warning{
    font-weight:600;
    border-radius:12px;
    transition:0.3s ease;
  }

  .btn-warning:hover{
    transform:scale(1.05);
    box-shadow:0 10px 25px rgba(0,0,0,0.25);
  }

  .bg-dark{
    transition:0.4s ease;
  }

  .bg-dark:hover{
    transform:scale(1.03);
  }

  .fas{
    transition:0.3s ease;
  }

  .bg-dark p:hover .fas{
    transform:scale(1.2);
    color:#ffc107;
  }
</style>


<div class="container mt-5 mb-5">

    <div class="text-center mb-5">
        <h1 class="text-warning fw-bold">Contact Us</h1>
        <p class="lead">We would love to hear from you!</p>
    </div>

    <div class="row">

        <!-- Contact Form -->
        <div class="col-md-7">
            <div class="card shadow p-4">
                <form action="/listings/contact" method="POST">

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input type="email" name="email" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea name="message" rows="4" class="form-control" required></textarea>
                    </div>

                    <button class="btn btn-warning w-100">Send Message</button>
                </form>
            </div>
        </div>

        <!-- Contact Info -->
        <div class="col-md-5">
            <div class="card shadow p-4 bg-dark text-light">
                <h4 class="text-warning">Get in Touch</h4>
                <p><i class="fas fa-map-marker-alt me-2"></i> Siliguri, India</p>
                <p><i class="fas fa-envelope me-2"></i> support@wanderlust.com</p>
                <p><i class="fas fa-phone me-2"></i> +91 9876543210</p>

                <hr>

                <p class="small">
                    Our support team is available 24/7 to assist you with bookings,
                    payments, or any travel queries.
                </p>
            </div>
        </div>

    </div>

</div>
