<% layout("/layout/boilerplate") %>

<script src="https://cdn.jsdelivr.net/npm/qrcodejs/qrcode.min.js"></script>

<style>
  body{
    background: linear-gradient(-45deg,#f8f9fa,#e9f7ef,#ffffff,#eef2f7);
    background-size:400% 400%;
    animation:bgMove 15s ease infinite;
  }

  @keyframes bgMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
  }

  .card{
    border-radius:1.5rem;
    transform:translateY(50px);
    opacity:0;
    animation:fadeUp 1s ease forwards;
    transition:0.4s ease;
  }

  @keyframes fadeUp{
    to{
      transform:translateY(0);
      opacity:1;
    }
  }

  .card:hover{
    transform:translateY(-8px);
    box-shadow:0 30px 60px rgba(0,0,0,0.2);
  }

  h3{
    animation:glowText 2s infinite alternate;
  }

  @keyframes glowText{
    from{ text-shadow:0 0 5px rgba(25,135,84,0.3); }
    to{ text-shadow:0 0 20px rgba(25,135,84,0.8); }
  }

  h4{
    animation:pulseAmount 2s infinite;
  }

  @keyframes pulseAmount{
    0%{transform:scale(1);}
    50%{transform:scale(1.08);}
    100%{transform:scale(1);}
  }

  .badge{
    animation:fadeIn 1.5s ease;
  }

  @keyframes fadeIn{
    from{opacity:0;}
    to{opacity:1;}
  }

  #qrcode{
    padding:15px;
    border-radius:20px;
    background:white;
    box-shadow:0 15px 35px rgba(0,0,0,0.15);
    animation:zoomIn 1.2s ease;
    transition:0.4s ease;
  }

  @keyframes zoomIn{
    from{transform:scale(0.7); opacity:0;}
    to{transform:scale(1); opacity:1;}
  }

  #qrcode:hover{
    transform:scale(1.08);
    box-shadow:0 20px 50px rgba(0,0,0,0.25);
  }

  .btn{
    transition:0.3s ease;
  }

  .btn:hover{
    transform:scale(1.08);
    box-shadow:0 12px 30px rgba(0,0,0,0.25);
  }

  hr{
    animation:expandLine 1s ease;
  }

  @keyframes expandLine{
    from{width:0; opacity:0;}
    to{width:100%; opacity:1;}
  }
</style>


<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">

      <div class="card shadow-lg border-0 rounded-4 p-4 text-center">

        <h3 class="fw-bold text-success mb-3">
          💳 Scan & Pay
        </h3>

        <hr>

        <% const finalAmount = (typeof totalPrice !== "undefined" && totalPrice > 0) 
            ? totalPrice 
            : (booking ? booking.totalPrice : 500); %>

        <h4 class="text-danger fw-bold mb-3">
          Total Amount: ₹ <%= finalAmount %>
        </h4>

        <div class="mb-3">
          <span class="badge bg-dark fs-6 px-3 py-2 rounded-pill">
            UPI ID: m74777abc@okicici
          </span>
        </div>

        <div id="qrcode" class="d-flex justify-content-center mb-4"></div>

        <div class="d-grid gap-3">
          <a href="/listings"
             class="btn btn-outline-secondary rounded-pill">
             Back to Listings
          </a>

          <a href="/listings/<%= booking ? booking._id : '' %>/success"
             class="btn btn-success rounded-pill shadow">
             Payment Completed
          </a>
        </div>

      </div>

    </div>
  </div>
</div>



<script>
  const amount = <%= finalAmount %>;
  const upiLink = `upi://pay?pa=m74777abc@okicici&pn=Mrinmoy%20Ghosh&am=${amount}&cu=INR`;

  new QRCode(document.getElementById("qrcode"), {
      text: upiLink,
      width: 220,
      height: 220
  });
</script>

