<!DOCTYPE html>
<html>
<head>
    <title>UPI QR</title>
    <link rel="stylesheet" href="/css/style2.css">
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs/qrcode.min.js"></script>
</head>
<body>

<div class="card">
    <h2>Scan & Pay</h2>

    <% let finalAmount = totalPrice && totalPrice > 0 ? totalPrice : 500; %>

    <p>Total Amount: ₹<%= finalAmount %></p>

    <div class="upi-id">UPI ID: m74777abc@okicici</div>
    <div id="qrcode"></div>
</div>

<br>

<button>
    <a href="/listings" class="minuuu">
        Back to all listings
    </a>
</button>

<script>
    const amount = <%= finalAmount %>;

    const upiLink = `upi://pay?pa=m74777abc@okicici&pn=Mrinmoy%20Ghosh&am=${amount}&cu=INR`;

    new QRCode(document.getElementById("qrcode"), {
        text: upiLink,
        width: 200,
        height: 200
    });
</script>

</body>
</html>
