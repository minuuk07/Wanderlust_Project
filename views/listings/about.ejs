<% layout("/layout/boilerplate") %>

<div class="container mt-5">

    <!-- Hero Section -->
    <div class="text-center mb-5">
        <h1 class="fw-bold text-warning">About Wanderlust</h1>
        <p class="lead">Your trusted partner for discovering beautiful stays across India.</p>
    </div>

    <!-- Our Story -->
    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <img src="data:image/png;base64,"
                 class="img-fluid rounded shadow"
                 alt="Travel Image">
        </div>
        <div class="col-md-6">
            <h3 class="fw-bold">Our Story</h3>
            <p>
                Wanderlust was created with a vision to make travel simple,
                affordable, and memorable. We connect travelers with unique stays,
                comfortable homes, and trusted hosts.
            </p>
            <p>
                Founded by <strong>Mrinmoy Ghosh</strong>, our platform is built
                with passion and dedication to provide seamless booking experiences.
            </p>
        </div>
    </div>

    <!-- Mission & Vision -->
    <div class="row text-center mb-5">
        <div class="col-md-6">
            <div class="card shadow p-4">
                <h4 class="text-warning">Our Mission</h4>
                <p>
                    To provide affordable, secure, and easy travel booking
                    experiences for everyone.
                </p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow p-4">
                <h4 class="text-warning">Our Vision</h4>
                <p>
                    To become India's most trusted travel booking platform
                    with thousands of happy customers.
                </p>
            </div>
        </div>
    </div>

    <!-- Why Choose Us -->
    <div class="mb-5">
        <h3 class="fw-bold text-center text-warning mb-4">Why Choose Wanderlust?</h3>

        <div class="row text-center">
            <div class="col-md-4">
                <i class="fas fa-shield-alt fa-3x text-warning mb-3"></i>
                <h5>Secure Booking</h5>
                <p>100% safe and secure payment process.</p>
            </div>

            <div class="col-md-4">
                <i class="fas fa-map-marked-alt fa-3x text-warning mb-3"></i>
                <h5>Verified Listings</h5>
                <p>Only trusted and verified properties available.</p>
            </div>

            <div class="col-md-4">
                <i class="fas fa-headset fa-3x text-warning mb-3"></i>
                <h5>24/7 Support</h5>
                <p>We are always here to help you anytime.</p>
            </div>
        </div>
    </div>


</div>

