<!-- tjis for wishlist -->
<script>
/* Wishlist Toggle - Fixed Version */
document.addEventListener("DOMContentLoaded", function() {
    console.log("Wishlist script loaded");
    
    const wishlistBtns = document.querySelectorAll(".wishlist-btn");
    console.log("Found", wishlistBtns.length, "wishlist buttons");
    
    wishlistBtns.forEach(btn => {
        btn.addEventListener("click", async function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const listingId = this.dataset.id;
            const heartIcon = this.querySelector("i");
            
            console.log("Wishlist button clicked for listing:", listingId);
            
            // Check if user is logged in (you can add a check here)
            <% if (!currUser) { %>
                window.location.href = "/login";
                return;
            <% } %>
            
            try {
                const res = await fetch(`/listings/wishlist/toggle/${listingId}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    }
                });
                
                if (!res.ok) {
                    throw new Error("Network response was not ok");
                }
                
                const data = await res.json();
                console.log("Response:", data);
                
                if (data.status === "added") {
                    // Change to solid heart
                    heartIcon.classList.remove("fa-regular");
                    heartIcon.classList.add("fa-solid");
                    btn.classList.add("active");
                    // Optional: Show success message
                    // alert("Added to wishlist!");
                } else if (data.status === "removed") {
                    // Change to regular heart
                    heartIcon.classList.remove("fa-solid");
                    heartIcon.classList.add("fa-regular");
                    btn.classList.remove("active");
                    // Optional: Show success message
                    // alert("Removed from wishlist!");
                }
                
            } catch (err) {
                console.error("Wishlist error:", err);
                alert("Something went wrong. Please try again.");
            }
        });
    });
    
    // Check which items are already in wishlist (if you want to pre-fill hearts)
    async function checkWishlistStatus() {
        <% if (currUser) { %>
            try {
                const res = await fetch("/listings/wishlist/status");
                const data = await res.json();
                
                data.wishlistIds.forEach(id => {
                    const btn = document.querySelector(`.wishlist-btn[data-id="${id}"]`);
                    if (btn) {
                        const heartIcon = btn.querySelector("i");
                        heartIcon.classList.remove("fa-regular");
                        heartIcon.classList.add("fa-solid");
                        btn.classList.add("active");
                    }
                });
            } catch (err) {
                console.error("Error checking wishlist status:", err);
            }
        <% } %>
    }
    
    // Uncomment if you want to check initial status
    // checkWishlistStatus();
});
</script>
