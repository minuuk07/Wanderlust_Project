<% layout("/layout/boilerplate") %>

<style>
  body{
    background: linear-gradient(to right,#f8f9fa,#eef2f7);
  }

  /* FILTER BAR */
  #filters{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    align-items:stretch;
    gap:1.5rem;
    padding:2rem 0;
  }

  /* Equal Filter Box */
  .filter{
    width:120px;
    height:120px;
    background:#fff;
    border-radius:1.25rem;        /* Bootstrap rounded-4 feel */
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:1rem;
    box-shadow:0 .5rem 1rem rgba(0,0,0,.08);
    transition:all .3s ease;
    cursor:pointer;
  }

  .filter i{
    font-size:26px;
    width:45px;
    height:45px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fe424d;
    margin-bottom:.5rem;
  }

  .filter p{
    margin:0;
    font-size:.85rem;
    font-weight:500;
  }

  .filter:hover{
    transform:translateY(-6px);
    box-shadow:0 1rem 2rem rgba(0,0,0,.15);
  }

  /* Booking Button Same Size */
  .booking-btn{
    height:120px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:1.25rem;
    padding:0 1.5rem;
    box-shadow:0 .5rem 1rem rgba(0,0,0,.08);
  }

  /* Tax Switch Same Size */
  .tax-switch{
    height:120px;
    display:flex;
    align-items:center;
    padding:0 1.5rem;
    border-radius:1.25rem;
    background:#fff;
    box-shadow:0 .5rem 1rem rgba(0,0,0,.08);
  }
</style>


<!-- FILTER SECTION -->
<div id="filters">

  <% const categories=[
    {name:"Trending",icon:"fa-fire",value:"trending"},
    {name:"Room",icon:"fa-bed",value:"room"},
    {name:"Iconic City",icon:"fa-mountain-city",value:"iconic-city"},
    {name:"Mountain",icon:"fa-mountain-sun",value:"mountain"},
    {name:"Pool",icon:"fa-person-swimming",value:"pool"},
    {name:"Camping",icon:"fa-campground",value:"camping"},
    {name:"Farms",icon:"fa-cow",value:"farms"},
    {name:"Arctic",icon:"fa-snowflake",value:"arctic"},
    {name:"Boats",icon:"fa-sailboat",value:"boats"}
  ]; %>

  <% categories.forEach(cat=>{ %>
    <div class="filter">
      <i class="fa-solid <%=cat.icon%>"></i>
      <p><%=cat.name%></p>
    </div>
  <% }) %>

  <!-- Your Booking -->
  <a href="/listings/mybooking"
     class="btn btn-dark booking-btn">
     <i class="fa-solid fa-calendar-check me-2"></i>
     Your Booking
  </a>

  <!-- Tax Toggle -->
  <div class="tax-switch">
    <div class="form-check form-switch m-0">
      <input class="form-check-input"
             type="checkbox"
             id="switchCheckDefault">
      <label class="form-check-label ms-2">
        Show GST
      </label>
    </div>
  </div>

</div>
