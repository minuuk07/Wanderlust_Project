<link rel="stylesheet" href="/css/style2.css">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <div class="card shadow-lg border-0 rounded-4 p-4">

                <h2 class="text-success text-center mb-3">
                    🎉 Booking Confirmed!
                </h2>

                <hr>

                <div class="mb-2">
                    <strong>Listing:</strong> <%= booking.listing.title %>
                </div>

                <div class="mb-2">
                    <strong>Name:</strong> <%= booking.name %>
                </div>

                <div class="mb-2">
                    <strong>Email:</strong> <%= booking.email %>
                </div>

                <div class="mb-2">
                    <strong>Check In:</strong> 
                    <%= booking.checkIn.toDateString() %>
                </div>

                <div class="mb-2">
                    <strong>Check Out:</strong> 
                    <%= booking.checkOut.toDateString() %>
                </div>

                <div class="mb-2">
                    <strong>Total Nights:</strong> 
                    <%= booking.totalDays %>
                </div>

                <h4 class="text-danger mt-3 text-center">
                    Total Paid: ₹
                    <%= booking.totalPrice > 0 ? booking.totalPrice : 500 %>
                </h4>

                <!-- Buttons Section -->
                <div class="d-flex justify-content-center gap-3 mt-4">

                    <a href="/listings"
                       class="btn btn-outline-primary px-4 rounded-pill">
                        Back to Listings
                    </a>

                    <a href="/listings/<%= booking._id %>/upi"
                       class="btn btn-success px-4 rounded-pill shadow">
                        Payment
                    </a>

                </div>

            </div>
        </div>
    </div>
</div>
