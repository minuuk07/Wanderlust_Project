<link rel="stylesheet" href="/css/style2.css">

<style>
  body{
    background: linear-gradient(-45deg,#e9f7ef,#f8f9fa,#ffffff,#e6fffa);
    background-size:400% 400%;
    animation:bgMove 12s ease infinite;
  }

  @keyframes bgMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
  }

  .confirm-card{
    border:none;
    border-radius:1.5rem;
    overflow:hidden;
    transform:translateY(40px);
    opacity:0;
    animation:fadeUp 1s ease forwards;
  }

  @keyframes fadeUp{
    to{
      transform:translateY(0);
      opacity:1;
    }
  }

  .confirm-header{
    background: linear-gradient(135deg,#198754,#20c997);
    color:white;
    padding:2rem 1rem;
    text-align:center;
    animation:fadeDown 1s ease;
  }

  @keyframes fadeDown{
    from{opacity:0; transform:translateY(-30px);}
    to{opacity:1; transform:translateY(0);}
  }

  .confirm-icon{
    font-size:60px;
    margin-bottom:10px;
    animation:pulse 1.5s infinite;
  }

  @keyframes pulse{
    0%{transform:scale(1);}
    50%{transform:scale(1.2);}
    100%{transform:scale(1);}
  }

  .detail-item{
    padding:.6rem 0;
    border-bottom:1px dashed #dee2e6;
    transition:0.3s ease;
  }

  .detail-item:hover{
    transform:translateX(5px);
    color:#198754;
  }

  .total-box{
    background:#fff3cd;
    border-radius:1rem;
    padding:1rem;
    margin-top:1rem;
    transition:0.3s ease;
  }

  .total-box:hover{
    transform:scale(1.05);
    box-shadow:0 10px 25px rgba(0,0,0,0.15);
  }

  .btn-pill{
    border-radius:50rem;
    padding:.6rem 1.8rem;
    font-weight:500;
    transition:0.3s ease;
  }

  .btn-pill:hover{
    transform:scale(1.07);
  }

  .btn-success{
    box-shadow:0 .5rem 1rem rgba(0,0,0,.15);
  }
</style>


<div class="container mt-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">

      <div class="card shadow-lg confirm-card">

        <!-- Header -->
        <div class="confirm-header">
          <div class="confirm-icon">✔</div>
          <h3 class="mb-0">Booking Confirmed!</h3>
          <small>Your reservation is successfully completed 🎉</small>
        </div>

        <div class="card-body p-4">

          <!-- Details -->
          <div class="detail-item">
            <strong>Listing:</strong> <%= booking.listing.title %>
          </div>

          <div class="detail-item">
            <strong>Name:</strong> <%= booking.name %>
          </div>

          <div class="detail-item">
            <strong>Email:</strong> <%= booking.email %>
          </div>

          <div class="detail-item">
            <strong>Check In:</strong>
            <%= booking.checkIn.toDateString() %>
          </div>

          <div class="detail-item">
            <strong>Check Out:</strong>
            <%= booking.checkOut.toDateString() %>
          </div>

          <div class="detail-item border-0">
            <strong>Total Nights:</strong>
            <%= booking.totalDays %>
          </div>

          <!-- Total Paid -->
          <div class="total-box text-center">
            <h4 class="text-danger mb-0">
              Total Paid: ₹
              <%= booking.totalPrice > 0 ? booking.totalPrice : 500 %>
            </h4>
          </div>

          <!-- Buttons -->
          <div class="d-flex justify-content-center gap-3 mt-4">

            <a href="/listings"
               class="btn btn-outline-dark btn-pill minuuu">
              Back to Listings
            </a>
      <br>
            <a href="/listings/<%= booking._id %>/upi"
               class="btn btn-success btn-pill minuuu">
              Proceed to Payment
            </a>

          </div>

        </div>
      </div>

    </div>
  </div>
</div>
