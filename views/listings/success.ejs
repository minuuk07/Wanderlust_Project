<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Booking Summary | Wanderlust</title>
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  
  <style>
    /* Animated Background */
    body {
      background: linear-gradient(-45deg, #e9f7ef, #f8f9fa, #ffffff, #e6fffa);
      background-size: 400% 400%;
      animation: bgMove 12s ease infinite;
      min-height: 100vh;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    @keyframes bgMove {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* Logo Styling */
    .logo-container {
      text-align: center;
      margin-bottom: 2rem;
      animation: fadeIn 1s ease;
    }

    .logo {
      font-size: 2.5rem;
      font-weight: 700;
      background: linear-gradient(135deg, #198754, #20c997);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
      position: relative;
    }

    .logo i {
      background: linear-gradient(135deg, #198754, #20c997);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      font-size: 2.8rem;
      margin-right: 10px;
    }

    .logo::after {
      content: '✦';
      position: absolute;
      top: -10px;
      right: -20px;
      font-size: 1.5rem;
      color: #20c997;
      animation: spin 4s linear infinite;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Main Card Animation */
    .summary-card {
      border: none;
      border-radius: 1.5rem;
      overflow: hidden;
      transform: translateY(40px);
      opacity: 0;
      animation: fadeUp 1s ease forwards;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    @keyframes fadeUp {
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    /* Header with Booking Label */
    .summary-header {
      background: linear-gradient(135deg, #2c3e50, #3498db);
      color: white;
      padding: 1.8rem 1rem;
      text-align: center;
      animation: fadeDown 1s ease;
      position: relative;
    }

    @keyframes fadeDown {
      from {
        opacity: 0;
        transform: translateY(-30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .header-icon {
      font-size: 50px;
      margin-bottom: 10px;
      color: rgba(255,255,255,0.9);
    }

    .summary-header h3 {
      font-weight: 600;
      margin-bottom: 5px;
    }

    .summary-header small {
      opacity: 0.9;
      font-size: 0.9rem;
    }

    /* Reference Badge */
    .ref-badge {
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(10px);
      padding: 0.5rem 1.2rem;
      border-radius: 50px;
      display: inline-block;
      margin-top: 1rem;
      font-size: 0.9rem;
      border: 1px solid rgba(255,255,255,0.2);
    }

    .ref-badge i {
      margin-right: 8px;
    }

    /* Detail Items with Hover Effect */
    .detail-item {
      padding: 1rem 0;
      border-bottom: 1px dashed #dee2e6;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
    }

    .detail-item:last-child {
      border-bottom: none;
    }

    .detail-item:hover {
      transform: translateX(8px);
      background: linear-gradient(90deg, rgba(52,152,219,0.05), transparent);
    }

    .detail-item i {
      width: 35px;
      font-size: 1.2rem;
      color: #3498db;
    }

    .detail-item strong {
      min-width: 120px;
      color: #2c3e50;
      font-weight: 600;
    }

    .detail-item span {
      color: #495057;
      font-weight: 500;
    }

    /* Guest Badge */
    .guest-badge {
      background: #e8f4fd;
      color: #3498db;
      padding: 0.4rem 1.2rem;
      border-radius: 50px;
      font-size: 0.95rem;
      display: inline-block;
      border: 1px solid rgba(52,152,219,0.2);
    }

    .guest-badge i {
      margin-right: 8px;
      color: #3498db;
    }

    /* Divider with Icon */
    .divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: 1.8rem 0 1.2rem;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      border-bottom: 2px dotted #cbd5e0;
    }

    .divider span {
      padding: 0 15px;
      color: #4a5568;
      font-weight: 600;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .divider i {
      color: #3498db;
      margin-right: 8px;
    }

    /* Price Breakdown Box */
    .price-box {
      background: linear-gradient(135deg, #f8fafc, #f1f5f9);
      border-radius: 1rem;
      padding: 1.5rem;
      margin: 1rem 0 1.5rem;
      transition: all 0.3s ease;
      border: 1px solid #e2e8f0;
    }

    .price-box:hover {
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .price-row {
      display: flex;
      justify-content: space-between;
      padding: 0.7rem 0;
      color: #334155;
      border-bottom: 1px dashed #cbd5e0;
    }

    .price-row:last-child {
      border-bottom: none;
    }

    .price-row.total {
      margin-top: 0.5rem;
      padding-top: 1rem;
      font-weight: 700;
      color: #198754;
      font-size: 1.2rem;
      border-top: 2px solid #cbd5e0;
      border-bottom: none;
    }

    .price-row i {
      width: 25px;
      color: #3498db;
    }

    /* Total Amount Highlight */
    .total-highlight {
      background: linear-gradient(135deg, #d4edda, #c3e6cb);
      border-radius: 1rem;
      padding: 1.2rem;
      text-align: center;
      margin: 1rem 0;
      border: 2px solid #198754;
    }

    .total-highlight .label {
      color: #155724;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .total-highlight .amount {
      color: #198754;
      font-size: 2.2rem;
      font-weight: 700;
      line-height: 1.2;
    }

    .total-highlight small {
      color: #155724;
      opacity: 0.8;
    }

    /* Booking Status Tag */
    .status-tag {
      background: #fff3cd;
      color: #856404;
      padding: 0.4rem 1.2rem;
      border-radius: 50px;
      font-size: 0.9rem;
      font-weight: 600;
      display: inline-block;
      border: 1px solid #ffeeba;
    }

    .status-tag i {
      margin-right: 6px;
      color: #856404;
    }

    /* Pill Buttons with Animation */
    .btn-pill {
      border-radius: 50rem;
      padding: 0.75rem 2rem;
      font-weight: 500;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .btn-pill:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    .btn-pill:active {
      transform: translateY(-1px);
    }

    .btn-pill i {
      margin-right: 8px;
    }

    /* Back Button */
    .btn-back {
      border-radius: 50rem;
      padding: 0.8rem 2rem;
      font-weight: 500;
      transition: all 0.3s ease;
      border: 2px solid #3498db;
      color: #3498db;
      background: transparent;
    }

    .btn-back:hover {
      background: #3498db;
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(52,152,219,0.3);
    }

    /* Success Button - For Payment */
    .btn-success {
      background: linear-gradient(135deg, #198754, #20c997);
      border: none;
      box-shadow: 0 5px 15px rgba(25,135,84,0.4);
      color: white;
      border-radius: 50rem;
      padding: 0.8rem 2rem;
      font-weight: 500;
      transition: all 0.3s ease;
    }

    .btn-success:hover {
      background: linear-gradient(135deg, #146c43, #1ba87e);
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(25,135,84,0.5);
    }

    .btn-success i {
      margin-right: 8px;
    }

    /* Button Container */
    .button-container {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-top: 2rem;
      flex-wrap: wrap;
    }

    /* Footer Note */
    .footer-note {
      text-align: center;
      margin-top: 1.5rem;
      color: #64748b;
      font-size: 0.85rem;
    }

    .footer-note i {
      color: #3498db;
    }

    /* Secure Payment Badge */
    .secure-badge {
      background: #e7f5ff;
      color: #0369a1;
      padding: 0.3rem 1rem;
      border-radius: 50px;
      font-size: 0.8rem;
      display: inline-block;
      margin-top: 0.5rem;
    }

    .secure-badge i {
      margin-right: 5px;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .container {
        padding: 10px;
      }
      
      .detail-item {
        flex-direction: column;
        align-items: flex-start;
        padding: 0.8rem 0;
      }
      
      .detail-item i {
        margin-bottom: 5px;
        width: auto;
      }
      
      .detail-item strong {
        min-width: auto;
        margin-bottom: 3px;
        font-size: 0.9rem;
      }
      
      .detail-item span {
        font-size: 1rem;
        font-weight: 600;
        margin-left: 0 !important;
      }
      
      .logo {
        font-size: 2rem;
      }
      
      .logo i {
        font-size: 2.3rem;
      }
      
      .button-container {
        flex-direction: column;
        gap: 10px;
      }
      
      .btn-back, .btn-success {
        width: 100%;
      }
    }

    /* Print Styles */
    @media print {
      body {
        background: white;
        animation: none;
      }
      
      .btn-back,
      .btn-success,
      .footer-note,
      .secure-badge {
        display: none;
      }
      
      .summary-card {
        box-shadow: none;
        border: 1px solid #ddd;
      }
    }

    /* Additional Animations */
    .pulse-slow {
      animation: pulseSlow 3s infinite;
    }

    @keyframes pulseSlow {
      0% { opacity: 1; }
      50% { opacity: 0.7; }
      100% { opacity: 1; }
    }

    /* Payment Icons */
    .payment-icons {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-top: 1rem;
      color: #6c757d;
    }

    .payment-icons i {
      font-size: 1.5rem;
      transition: all 0.3s ease;
    }

    .payment-icons i:hover {
      color: #198754;
      transform: scale(1.2);
    }
  </style>
</head>
<body>

  <div class="container mt-4 mt-md-5 mb-5">
    <div class="row justify-content-center">
      <div class="col-lg-6 col-md-8 col-11">
        
        <!-- Logo Section -->
        <div class="logo-container">
          <span class="logo">
            <i class="fas fa-compass"></i> Wanderlust
          </span>
          <p class="text-muted mt-2" style="font-size: 0.9rem;">
            <i class="fas fa-map-marker-alt me-1"></i> Your travel companion
          </p>
        </div>

        <!-- Main Summary Card -->
        <div class="card shadow-lg summary-card">
          
          <!-- Header -->
          <div class="summary-header">
            <div class="header-icon">
              <i class="fas fa-file-invoice"></i>
            </div>
            <h3 class="mb-0">Booking Summary</h3>
            <small>Review your reservation details below</small>
            
            <!-- Reference Badge -->
            <div class="ref-badge">
              <i class="fas fa-hashtag"></i>
              <span>REF: WAND-<%= Date.now ? Date.now().toString().slice(-8) : '23A7B9C4' %></span>
            </div>
          </div>

          <!-- Card Body with ALL Details -->
          <div class="card-body p-3 p-md-4">
            
            <!-- Guest Welcome -->
            <div class="text-center mb-4">
              <span class="guest-badge">
                <i class="fas fa-user-circle"></i>
                <%= booking && booking.name ? booking.name.split(' ')[0] : 'Guest' %>'s Reservation
              </span>
              
              <!-- Status -->
              <span class="status-tag ms-2">
                <i class="fas fa-clock"></i> Pending Payment
              </span>
            </div>

            <!-- COMPLETE BOOKING DETAILS -->
            
            <!-- Listing Details -->
            <div class="detail-item">
              <i class="fas fa-home"></i>
              <strong>Listing</strong>
              <span class="ms-2"><%= booking && booking.listing && booking.listing.title ? booking.listing.title : 'Luxury Beachfront Villa' %></span>
            </div>

            <!-- Location -->
            <div class="detail-item">
              <i class="fas fa-map-pin"></i>
              <strong>Location</strong>
              <span class="ms-2"><%= booking && booking.location ? booking.location : 'Goa, India' %></span>
            </div>

            <!-- Guest Full Name -->
            <div class="detail-item">
              <i class="fas fa-user"></i>
              <strong>Full Name</strong>
              <span class="ms-2"><%= booking && booking.name ? booking.name : 'Rahul Sharma' %></span>
            </div>

            <!-- Email -->
            <div class="detail-item">
              <i class="fas fa-envelope"></i>
              <strong>Email</strong>
              <span class="ms-2"><%= booking && booking.email ? booking.email : 'rahul.sharma@email.com' %></span>
            </div>

            <!-- Phone -->
            <div class="detail-item">
              <i class="fas fa-phone"></i>
              <strong>Phone</strong>
              <span class="ms-2"><%= booking && booking.phone ? booking.phone : '+91 98765 43210' %></span>
            </div>

            <!-- Check In Date -->
            <div class="detail-item">
              <i class="fas fa-calendar-check"></i>
              <strong>Check In</strong>
              <span class="ms-2">
                <%= booking && booking.checkIn ? new Date(booking.checkIn).toLocaleDateString('en-IN', { 
                  weekday: 'short', 
                  year: 'numeric', 
                  month: 'short', 
                  day: 'numeric' 
                }) : 'Mon, Mar 15, 2026' %>
              </span>
            </div>

            <!-- Check Out Date -->
            <div class="detail-item">
              <i class="fas fa-calendar-times"></i>
              <strong>Check Out</strong>
              <span class="ms-2">
                <%= booking && booking.checkOut ? new Date(booking.checkOut).toLocaleDateString('en-IN', { 
                  weekday: 'short', 
                  year: 'numeric', 
                  month: 'short', 
                  day: 'numeric' 
                }) : 'Thu, Mar 18, 2026' %>
              </span>
            </div>

            <!-- Total Nights -->
            <div class="detail-item">
              <i class="fas fa-moon"></i>
              <strong>Total Nights</strong>
              <span class="ms-2"><%= booking && booking.totalDays ? booking.totalDays : '3' %> Nights</span>
            </div>

            <!-- Number of Guests -->
            <div class="detail-item">
              <i class="fas fa-users"></i>
              <strong>Guests</strong>
              <span class="ms-2"><%= booking && booking.guests ? booking.guests : '2' %> Adults</span>
            </div>

            <!-- Room Type -->
            <div class="detail-item">
              <i class="fas fa-bed"></i>
              <strong>Room Type</strong>
              <span class="ms-2"><%= booking && booking.roomType ? booking.roomType : 'Deluxe Ocean View Suite' %></span>
            </div>

            <!-- Special Requests -->
            <div class="detail-item">
              <i class="fas fa-comment"></i>
              <strong>Special Requests</strong>
              <span class="ms-2"><%= booking && booking.specialRequests ? booking.specialRequests : 'No special requests' %></span>
            </div>

            <!-- Check-in Time -->
            <div class="detail-item">
              <i class="fas fa-clock"></i>
              <strong>Check-in Time</strong>
              <span class="ms-2">02:00 PM - 12:00 AM</span>
            </div>

            <!-- Check-out Time -->
            <div class="detail-item">
              <i class="fas fa-clock"></i>
              <strong>Check-out Time</strong>
              <span class="ms-2">11:00 AM</span>
            </div>

            <!-- Booking Date -->
            <div class="detail-item">
              <i class="fas fa-calendar-alt"></i>
              <strong>Booked On</strong>
              <span class="ms-2"><%= booking && booking.bookedOn ? new Date(booking.bookedOn).toLocaleDateString() : 'Mar 10, 2026' %></span>
            </div>

            <!-- Divider -->
            <div class="divider">
              <span><i class="fas fa-calculator"></i>PRICE BREAKDOWN</span>
            </div>

            <!-- Detailed Price Breakdown -->
            <div class="price-box">
              <% 
                const nights = (booking && booking.totalDays) || 3;
                const total = (booking && booking.totalPrice > 0) ? booking.totalPrice : 5849;
                const pricePerNight = Math.round(total / nights);
                const tax = Math.round(total * 0.12);
                const cleaningFee = 499;
                const serviceFee = 199;
                const subtotal = total - tax - cleaningFee - serviceFee;
              %>
              
              <div class="price-row">
                <span><i class="fas fa-tag"></i> Price per night</span>
                <span class="fw-bold">₹<%= pricePerNight.toLocaleString('en-IN') %></span>
              </div>
              
              <div class="price-row">
                <span><i class="fas fa-calculator"></i> <%= nights %> nights × ₹<%= pricePerNight.toLocaleString('en-IN') %></span>
                <span>₹<%= (pricePerNight * nights).toLocaleString('en-IN') %></span>
              </div>
              
              <div class="price-row">
                <span><i class="fas fa-broom"></i> Cleaning fee</span>
                <span>₹<%= cleaningFee.toLocaleString('en-IN') %></span>
              </div>
              
              <div class="price-row">
                <span><i class="fas fa-file-invoice"></i> Service fee</span>
                <span>₹<%= serviceFee.toLocaleString('en-IN') %></span>
              </div>
              
              <div class="price-row">
                <span><i class="fas fa-percent"></i> GST (12%)</span>
                <span>₹<%= tax.toLocaleString('en-IN') %></span>
              </div>
              
              <div class="price-row total">
                <span><i class="fas fa-rupee-sign"></i> Total Amount</span>
                <span class="h5 mb-0">₹<%= (total).toLocaleString('en-IN') %></span>
              </div>
            </div>

            <!-- Total Amount Highlight -->
            <div class="total-highlight">
              <div class="label">TOTAL AMOUNT TO PAY</div>
              <div class="amount">₹<%= (booking && booking.totalPrice) ? booking.totalPrice.toLocaleString('en-IN') : '5,849' %></div>
              <small><i class="fas fa-shield-alt me-1"></i> Inclusive of all taxes</small>
            </div>

            <!-- BUTTONS SECTION - WITH PROCEED TO PAYMENT -->
            <div class="button-container">
              <!-- Back to Listings Button -->
              <a href="/listings" class="btn-back">
                <i class="fas fa-arrow-left"></i> Back to Listings
              </a>
              
              <!-- PROCEED TO PAYMENT BUTTON - ADDED HERE -->
              <a href="/listings/<%= booking && booking._id ? booking._id : '123' %>/upi" class="btn-success">
                <i class="fas fa-credit-card"></i> Proceed to Payment
              </a>
            </div>

            <!-- Secure Payment Badge -->
            <div class="text-center mt-3">
              <span class="secure-badge">
                <i class="fas fa-lock"></i> Secure 128-bit encrypted payment
              </span>
            </div>

            <!-- Payment Methods Icons -->
            <div class="payment-icons">
              <i class="fab fa-cc-visa" title="Visa"></i>
              <i class="fab fa-cc-mastercard" title="Mastercard"></i>
              <i class="fab fa-cc-amex" title="American Express"></i>
              <i class="fab fa-cc-upi" title="UPI"></i>
              <i class="fab fa-google-pay" title="Google Pay"></i>
              <i class="fab fa-paypal" title="PayPal"></i>
            </div>

            <!-- Additional Information -->
            <div class="mt-4 p-3 bg-light rounded-3">
              <h6 class="mb-2"><i class="fas fa-info-circle me-2 text-primary"></i>Booking Policies</h6>
              <ul class="small text-muted mb-0 ps-3">
                <li>Free cancellation within 48 hours of booking</li>
                <li>Check-in from 2:00 PM - 12:00 AM</li>
                <li>Security deposit of ₹2,000 payable at property</li>
                <li>ID proof required at check-in</li>
              </ul>
            </div>

            <!-- Property Rules -->
            <div class="mt-3 p-3 bg-light rounded-3">
              <h6 class="mb-2"><i class="fas fa-gavel me-2 text-primary"></i>House Rules</h6>
              <ul class="small text-muted mb-0 ps-3">
                <li>No smoking inside the property</li>
                <li>No pets allowed</li>
                <li>Quiet hours after 10:00 PM</li>
                <li>Parties/events not allowed</li>
              </ul>
            </div>

            <!-- Print Option -->
            <div class="text-center mt-3">
              <button onclick="window.print()" class="btn btn-link text-muted text-decoration-none">
                <i class="fas fa-print me-1"></i> Print Summary
              </button>
            </div>

          </div>
        </div>

        <!-- Footer Note -->
        <div class="footer-note">
          <i class="fas fa-regular fa-note-sticky me-1"></i>
          Complete your payment to confirm your booking.
          <br>
          <span class="mt-2 d-inline-block">© 2026 Wanderlust. All rights reserved.</span>
        </div>

      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Optional JavaScript -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Smooth scroll to top
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
      
      // Add click tracking for payment button (optional)
      const paymentBtn = document.querySelector('.btn-success');
      if (paymentBtn) {
        paymentBtn.addEventListener('click', function() {
          console.log('Proceeding to payment for booking...');
        });
      }
    });
  </script>

</body>
</html>
