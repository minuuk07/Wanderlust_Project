<% layout("/layout/boilerplate")%>

<style>
  body{
    background: linear-gradient(-45deg,#eef2ff,#f8f9fa,#ffffff,#e0f7ff);
    background-size:400% 400%;
    animation:bgMove 14s ease infinite;
  }

  @keyframes bgMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
  }

  .card{
    border-radius:1.5rem;
    transform:translateY(50px);
    opacity:0;
    animation:fadeUp 1s ease forwards;
    transition:0.4s ease;
  }

  @keyframes fadeUp{
    to{
      transform:translateY(0);
      opacity:1;
    }
  }

  .card:hover{
    transform:translateY(-6px);
    box-shadow:0 25px 50px rgba(0,0,0,0.15);
  }

  h2{
    animation:glowText 2s infinite alternate;
  }

  @keyframes glowText{
    from{ text-shadow:0 0 5px rgba(13,110,253,0.3); }
    to{ text-shadow:0 0 20px rgba(13,110,253,0.7); }
  }

  .form-control,
  .form-select{
    transition:0.3s ease;
  }

  .form-control:focus,
  .form-select:focus{
    transform:scale(1.03);
    box-shadow:0 0 15px rgba(13,110,253,0.25);
  }

  .form-label{
    transition:0.3s ease;
  }

  .form-control:focus + .valid-feedback,
  .form-control:focus + .invalid-feedback{
    animation:fadeIn 0.5s ease;
  }

  @keyframes fadeIn{
    from{opacity:0;}
    to{opacity:1;}
  }

  .btn{
    transition:0.3s ease;
  }

  .btn:hover{
    transform:scale(1.08);
    box-shadow:0 12px 30px rgba(0,0,0,0.25);
  }

  .row .col-md-4,
  .row .col-md-8{
    transition:0.3s ease;
  }

  .row .col-md-4:hover,
  .row .col-md-8:hover{
    transform:translateY(-4px);
  }
</style>


<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="card shadow-lg border-0 rounded-4 p-4">

        <h2 class="text-center fw-bold text-primary mb-4">
          ✨ Create a New Listing
        </h2>

        <form method="POST" 
              action="/listings" 
              novalidate 
              class="needs-validation"
              enctype="multipart/form-data">

          <!-- Title -->
          <div class="mb-4">
            <label class="form-label fw-semibold">Title</label>
            <input name="listing[title]" 
                   placeholder="Enter your title"
                   type="text" 
                   class="form-control rounded-3 shadow-sm"
                   required>
            <div class="valid-feedback">Title Looks Good</div>
            <div class="invalid-feedback">Please Enter a Valid Title</div>
          </div>

          <!-- Description -->
          <div class="mb-4">
            <label class="form-label fw-semibold">Description</label>
            <textarea name="listing[description]"
                      rows="5"
                      placeholder="Enter your description"
                      required
                      class="form-control rounded-3 shadow-sm"></textarea>
            <div class="invalid-feedback">Please Enter Description</div>
          </div>

          <!-- Image -->
          <div class="mb-4">
            <label class="form-label fw-semibold">Upload Image</label>
            <input name="listing[image]"
                   type="file"
                   required
                   class="form-control rounded-3 shadow-sm">
          </div>

          <!-- Price & Country -->
          <div class="row">
            <div class="mb-4 col-md-4">
              <label class="form-label fw-semibold">Price</label>
              <input name="listing[price]"
                     placeholder="Enter your price"
                     required
                     type="number"
                     class="form-control rounded-3 shadow-sm"/>
              <div class="invalid-feedback">Please Enter a Valid Price</div>
            </div>

            <div class="mb-4 col-md-8">
              <label class="form-label fw-semibold">Country</label>
              <input name="listing[country]"
                     required
                     placeholder="Enter your country"
                     type="text"
                     class="form-control rounded-3 shadow-sm"/>
              <div class="invalid-feedback">Please Enter a Country</div>
            </div>
          </div>

          <!-- Location -->
          <div class="mb-4">
            <label class="form-label fw-semibold">Location</label>
            <input name="listing[location]"
                   required
                   placeholder="Enter your location"
                   type="text"
                   class="form-control rounded-3 shadow-sm"/>
            <div class="invalid-feedback">Please Enter a Location</div>
          </div>

          <!-- Category -->
          <div class="mb-4">
            <label class="form-label fw-semibold">Category</label>
            <select name="listing[category]" 
                    class="form-select rounded-3 shadow-sm"
                    required>
              <option value="">Select Category</option>
              <option value="trending">🔥 Trending</option>
              <option value="room">🛏️ Room</option>
              <option value="iconic-city">🏙️ Iconic City</option>
              <option value="mountain">🏔️ Mountain</option>
              <option value="custless">🏰 Custless</option>
              <option value="pool">🏊 Pool</option>
              <option value="camping">🏕️ Camping</option>
              <option value="farms">🐄 Farms</option>
              <option value="arctic">❄️ Arctic</option>
              <option value="doms">🏠 Doms</option>
              <option value="boats">🚤 Boats</option>
            </select>
          </div>

          <!-- Submit Button -->
          <div class="d-grid mt-4">
            <button class="btn btn-primary btn-lg rounded-pill shadow">
              Submit Listing
            </button>
          </div>

        </form>

      </div>

    </div>
  </div>
</div>
