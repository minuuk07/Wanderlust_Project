

<% layout("/layout/boilerplate")%>;
<div class="row mt-2">
    <div class="col-8 offset-2">
<h1>Edit this listings</h1>
<br>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT"
         novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3"> 
            <label for="title" class="form-label"></label><b>Title</b></label>
             <input name="listing[title]" required value="<%=listing.title%>" type="text"  class="form-control">
             <div class="valid-feedback">
    Title Looks Good
    </div>
    <div class="invalid-feedback">Please Enter a Valid Title</div>
             </div>

    <div class="mb-3">
                    <label for="Description" class="form-label"></label><b>Description</b></label>
                     <textarea name="listing[description]" required rows="5" cols="50" type="text" value="<%=listing.description%>"  class="form-control"><%=listing.description%></textarea>
     
             <div class="invalid-feedback">Please Enter Description</div>

         </div>
    
    <div class="mb-3">
        <h5> Original Listing Image</h5>
         <img src="<%=originalImage%>" class="imagg">
         </div>
     
     
         <div class="mb-3">
         <label for="Image" class="form-label"></label><b>Upload new Image</b></label>
         <input name="listing[image]"   type="file"  class="form-control">
               

         </div>
     
     <div class="row">
<div class="mb-3 col-md-4">
         <label for="Price" class="form-label"></label><b>Price</b></label>
         <input name="listing[price]" required value="<%=listing.price%>" type="number"  class="form-control">
             <div class="invalid-feedback">Please Enter a Valid Price</div>

        </div>


    <div class="mb-3 col-md-8">
        <label for="Country" class="form-label"></label><b>Country</b></label>
          <input name="listing[country]" required value="<%=listing.country%>" type="text"  class="form-control">
         <div class="invalid-feedback">Please Enter a  Country</div>

    </div>
     </div>
        
    
    <div class="mb-3">
        <label for="Location" class="form-label"></label><b>Location</b></label>
        <input name="listing[location]" required value="<%=listing.location%>" type="text"  class="form-control">
        <div class="invalid-feedback">Please Enter a  Loaction</div>

    </div>

    
    
  
    
    <br>
    <button class="btn btn-dark add-btn">submit</button>
    <br> <br>
    </form>
</body>

    </div>
</div>

    