<% layout("/layout/boilerplate")%>

<style>
  body{
    background: linear-gradient(-45deg,#fff3cd,#f8f9fa,#ffffff,#fff8e1);
    background-size:400% 400%;
    animation:bgMove 14s ease infinite;
  }

  @keyframes bgMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
  }

  .card{
    transform:translateY(50px);
    opacity:0;
    animation:fadeUp 1s ease forwards;
    transition:0.4s ease;
  }

  @keyframes fadeUp{
    to{
      transform:translateY(0);
      opacity:1;
    }
  }

  .card:hover{
    transform:translateY(-6px);
    box-shadow:0 25px 50px rgba(0,0,0,0.15);
  }

  h1{
    animation:glowText 2s infinite alternate;
  }

  @keyframes glowText{
    from{ text-shadow:0 0 5px rgba(255,193,7,0.3); }
    to{ text-shadow:0 0 20px rgba(255,193,7,0.8); }
  }

  .form-control{
    transition:0.3s ease;
    border-radius:12px;
  }

  .form-control:focus{
    transform:scale(1.03);
    box-shadow:0 0 15px rgba(255,193,7,0.3);
    border-color:#ffc107;
  }

  .btn{
    border-radius:50rem;
    transition:0.3s ease;
  }

  .btn:hover{
    transform:scale(1.08);
    box-shadow:0 12px 30px rgba(0,0,0,0.25);
  }

  
 .reset{
  display:block;                 /* 🔥 full width */
  width:100%;                    /* 🔥 same as login button */
  margin:15px 0;
  text-align:center;
  font-weight:600;
  font-size:15px;
  text-decoration:none;
  padding:12px 0;
  border-radius:50rem;
  background:#ffc107;
  color:#000;
  box-shadow:0 6px 15px rgba(0,0,0,0.15);
  transition:all 0.3s ease;
}

.reset:hover{
  background:#ff9800;
  transform:translateY(-3px);
  box-shadow:0 10px 25px rgba(0,0,0,0.25);
}
  .reset::before{
    content:"";
    position:absolute;
    top:0;
    left:-100%;
    width:100%;
    height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,0.6),transparent);
    transition:0.6s;
  }

  .reset:hover::before{
    left:100%;
  }

  
</style>


<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
  <div class="row w-100">
    
    <div class="col-md-6 col-lg-5 mx-auto">
      
      <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">
          
          <h1 class="text-center mb-4 text-warning fw-bold">Login</h1>

          <form action="/login" method="POST" novalidate class="needs-validation">

            <div class="mb-3">
              <label for="username" class="form-label fw-semibold">
                Username
              </label>

              <input 
                name="username"
                id="username"
                type="text" 
                class="form-control form-control-lg"
                required
              >

              <div class="valid-feedback">
                Looks Good
              </div>

              <div class="invalid-feedback">
                Please Enter a Valid username
              </div>
            </div>

            <!-- Password -->
            <div class="mb-4">
              <label for="password" class="form-label fw-semibold">
                Password
              </label>

              <input 
                name="password"
                id="password"
                type="password" 
                class="form-control form-control-lg"
                autocomplete="new-password"
                required
              >

              <div class="invalid-feedback">
                Please enter a valid password.
              </div>
            </div>

<br>
<a href="/forgot-password" class="reset">Forgot Password?</a>
<br>

            <!-- Button -->
            <div class="d-grid">
<br>
              <button class="btn btn-warning btn-lg fw-semibold shadow-sm">
                Log In
              </button>
            </div>

          </form>

        </div>
      </div>

    </div>

  </div>
</div>
