<% layout("/layout/boilerplate") %>

<style>
  body{
    background: linear-gradient(-45deg,#e3f2fd,#f8f9fa,#ffffff,#e0f7fa);
    background-size:400% 400%;
    animation:bgMove 14s ease infinite;
  }

  @keyframes bgMove{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
  }

  .card{
    transform:translateY(50px);
    opacity:0;
    animation:fadeUp 1s ease forwards;
    transition:0.4s ease;
  }

  @keyframes fadeUp{
    to{
      transform:translateY(0);
      opacity:1;
    }
  }

  .card:hover{
    transform:translateY(-6px);
    box-shadow:0 25px 50px rgba(0,0,0,0.15);
  }

  h2{
    animation:glowText 2s infinite alternate;
  }

  @keyframes glowText{
    from{ text-shadow:0 0 5px rgba(13,110,253,0.3); }
    to{ text-shadow:0 0 20px rgba(13,110,253,0.7); }
  }

  .form-control{
    transition:0.3s ease;
  }

  .form-control:focus{
    transform:scale(1.03);
    box-shadow:0 0 15px rgba(13,110,253,0.3);
    border-color:#0d6efd;
  }

  .btn{
    transition:0.3s ease;
  }

  .btn:hover{
    transform:scale(1.05);
    box-shadow:0 12px 30px rgba(0,0,0,0.25);
  }

  a{
    transition:0.3s ease;
  }

  a:hover{
    color:#0d6efd !important;
    transform:translateX(4px);
  }
</style>


<div class="container d-flex justify-content-center align-items-center vh-100">
  <div class="card shadow-lg border-0 rounded-4 p-4" style="width: 100%; max-width: 420px;">
    
    <div class="text-center mb-4">
      <h2 class="fw-bold text-primary">Forgot Password</h2>
      <p class="text-muted small">Enter your registered email to receive OTP</p>
    </div>

    <form action="/forgot-password" method="POST" novalidate>
      
      <div class="form-floating mb-3">
        <input 
          type="email" 
          name="email" 
          class="form-control rounded-3" 
          id="email" 
          placeholder="name@example.com" 
          required>
        <label for="email">Email address</label>
      </div>

      <div class="d-grid">
        <button class="btn btn-primary btn-lg rounded-3">
          Send OTP
        </button>
      </div>

    </form>

    <div class="text-center mt-3">
      <a href="/login" class="text-decoration-none small text-secondary">
        Back to Login
      </a>
    </div>

  </div>
</div>
